# Robinhood public defaults are used if these are omitted, but production should use managed/archive RPCs.
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional reference RPC. In strict release certification, expected code hashes should be pinned in deployment manifests.
ETHEREUM_REFERENCE_RPC_URL=

# Application (replace secret placeholders through a secret manager).
# DATABASE_URL is the runtime/pooler endpoint; DIRECT_URL is preferred for
# transactional schema migration and isolated PostgreSQL certification.
DATABASE_URL=postgresql://nexmarkets:nexmarkets@localhost:5432/nexmarkets
DIRECT_URL=postgresql://nexmarkets:nexmarkets@localhost:5432/nexmarkets
SESSION_SECRET=replace-in-secret-manager
APP_ORIGIN=https://www.nexmarkets.xyz
CDP_PROJECT_ID=
NODE_ENV=development
PORT=4010
ROBINHOOD_CHAIN_ID=4663
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_MAINNET_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Mainnet settlement token only. Robinhood testnet intentionally uses the
# deployed MockUSDG token from its testnet deployment manifest; it must never
# be promoted to production or relabeled as USDG.
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
SEAPORT_16_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
SECONDARY_FEE_RECIPIENT=
NEX_LISTING_REGISTRY_ADDRESS=
NEX_MARKETS_ZONE_ADDRESS=
NEX_ROYALTY_VAULT_ADDRESS=
NEX_MINT_CONTROLLER_ADDRESS=
NEX_PASS_FACTORY_ADDRESS=
NEX_LAUNCH_REGISTRY_ADDRESS=
NEX_ADVANTAGE_REGISTRY_ADDRESS=
NEX_TBA_RESOLVER_ADDRESS=

# Base Sepolia addresses below come from the verified testnet deployment.
# Base mainnet remains empty until its Safe-controlled release is approved.
BASE_SEPOLIA_PROTOCOL_ADMIN_SAFE_ADDRESS=0xE6D0846e6C0b51C61FdDb593A1914b85181E5783
BASE_SEPOLIA_SECONDARY_FEE_RECIPIENT=0xE6D0846e6C0b51C61FdDb593A1914b85181E5783
BASE_SEPOLIA_NEX_LISTING_REGISTRY_ADDRESS=0x6F33B84325041d15443827540057763bCD3FEAD8
BASE_SEPOLIA_NEX_MARKETS_ZONE_ADDRESS=0x7dEFe2d8392A2096EdA97DD9b606b6A404843c2d
BASE_SEPOLIA_NEX_ROYALTY_VAULT_ADDRESS=0x2A75E1568703B3fd2B692889e08f1Da0949bE618
BASE_SEPOLIA_NEX_MINT_CONTROLLER_ADDRESS=0x38Ca185Bd179989bFCAa05aF61B0de837B8FcB97
BASE_SEPOLIA_NEX_PASS_FACTORY_ADDRESS=0x8fDE37c4C1A60733c9842f336fc331c4C7d8eB41
BASE_SEPOLIA_NEX_LAUNCH_REGISTRY_ADDRESS=0x811D7B04d37118F71002c4abe112bc41161e3D53
BASE_SEPOLIA_NEX_ADVANTAGE_REGISTRY_ADDRESS=0xDe076a2D0F998a69A87226041E6075dAd534ECdD
BASE_MAINNET_PROTOCOL_ADMIN_SAFE_ADDRESS=
BASE_MAINNET_SECONDARY_FEE_RECIPIENT=
BASE_MAINNET_NEX_LISTING_REGISTRY_ADDRESS=
BASE_MAINNET_NEX_MARKETS_ZONE_ADDRESS=
BASE_MAINNET_NEX_ROYALTY_VAULT_ADDRESS=
BASE_MAINNET_NEX_MINT_CONTROLLER_ADDRESS=
BASE_MAINNET_NEX_PASS_FACTORY_ADDRESS=
BASE_MAINNET_NEX_LAUNCH_REGISTRY_ADDRESS=
BASE_MAINNET_NEX_ADVANTAGE_REGISTRY_ADDRESS=
BASE_SEPOLIA_NEXMARKETS_SUBGRAPH_URL=
BASE_MAINNET_NEXMARKETS_SUBGRAPH_URL=
BASE_SEPOLIA_SEAPORT_16_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
BASE_MAINNET_SEAPORT_16_ADDRESS=0x0000000000000068F116a894984e2DB1123eB395
ERC6551_REGISTRY_ADDRESS=
ERC6551_ACCOUNT_IMPLEMENTATION_ADDRESS=
ERC6551_REGISTRY_RUNTIME_CODE_HASH=
ERC6551_ACCOUNT_RUNTIME_CODE_HASH=
INDEXER_POLL_MS=5000
INDEXER_BATCH_SIZE=250
INDEXER_MAX_LAG_BLOCKS=120
INDEXER_MAX_FINALITY_LAG_BLOCKS=120
ROBINHOOD_FINALITY_BLOCKS=12
CHAIN_WORKER_POLL_MS=5000
NOTIFICATION_WEBHOOK_URL=
OUTBOX_BATCH_SIZE=50
RECONCILIATION_ATTEMPTS=3
OBJECT_STORAGE_BUCKET=nexmarkets-local
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional AWS STS token only; do not place a Cloudflare cfat_ API token here.
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=900
MEDIA_SIGNING_KEY=

# Cloudflare API token for optional R2 bucket CORS management (never an S3 session token).
CLOUDFLARE_API_TOKEN=

# Goldsky Turbo. Never commit the API key or sink secret value.
GOLDSKY_API_KEY=
GOLDSKY_PROJECT=
# Official Goldsky Turbo datasets (fixed; do not replace with a custom slug).
GOLDSKY_ROBINHOOD_MAINNET_NETWORK=robinhood-mainnet
GOLDSKY_ROBINHOOD_TESTNET_NETWORK=robinhood-testnet
GOLDSKY_POSTGRES_SECRET_NAME=NEXMARKETS_POSTGRES
# Goldsky-hosted Subgraph GraphQL endpoint (returned by goldsky subgraph deploy)
NEXMARKETS_SUBGRAPH_URL=

# Observability endpoints/tokens are optional locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LOG_LEVEL=info

# Safe v1.4.1 deployment (never commit .env or a private key). The planner
# defaults to mainnet; use --network=robinhood-testnet for testnet.
# The deploy script is read-only by default. It submits only with --broadcast
# and SAFE_DEPLOY_CONFIRM=I_UNDERSTAND_THIS_SUBMITS_A_TRANSACTION.
DEPLOYER_PRIVATE_KEY=
SAFE_OWNER_ADDRESSES=
SAFE_THRESHOLD=
SAFE_SALT_NONCE=0
SAFE_SINGLETON_ADDRESS=0x41675C099F32341bf84BFc5382aF534df5C7461a
SAFE_PROXY_FACTORY_ADDRESS=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67
SAFE_FALLBACK_HANDLER_ADDRESS=0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99

# Deterministic NexMarkets V1 deployment inputs. Addresses only; no user keys.
PROTOCOL_ADMIN_SAFE_ADDRESS=
PRIMARY_FEE_RECIPIENT=
SECONDARY_FEE_RECIPIENT=
GOVERNANCE_TRANSITION=RAISE_THRESHOLD_TO_2_PLUS

# Evidence-backed production gates. These are false by default and must only
# be promoted by the release process after the corresponding report passes;
# changing a boolean alone is not production certification.
NEXMARKETS_DATABASE_MIGRATION_VERIFIED=false
NEXMARKETS_CONTRACT_CONFIG_VERIFIED=false
NEXMARKETS_PAYMENT_TOKEN_VERIFIED=false
NEXMARKETS_TESTNET_E2E_PASSED=false
NEXMARKETS_SECURITY_GATE_PASSED=false
NEXMARKETS_CRITICAL_TESTS_PASSED=false
