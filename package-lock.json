{
  "name": "nexmarkets-production",
  "version": "0.1.0-phase01",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nexmarkets-production",
      "version": "0.1.0-phase01",
      "workspaces": [
        "apps/*",
        "services/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "apps/api": {
      "name": "@nexmarkets/api"
    },
    "apps/web": {
      "name": "@nexmarkets/web"
    },
    "node_modules/@nexmarkets/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@nexmarkets/auth": {
      "resolved": "packages/auth",
      "link": true
    },
    "node_modules/@nexmarkets/chain": {
      "resolved": "packages/chain",
      "link": true
    },
    "node_modules/@nexmarkets/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@nexmarkets/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "node_modules/@nexmarkets/indexer": {
      "resolved": "services/indexer",
      "link": true
    },
    "node_modules/@nexmarkets/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@nexmarkets/worker": {
      "resolved": "services/worker",
      "link": true
    },
    "packages/auth": {
      "name": "@nexmarkets/auth"
    },
    "packages/chain": {
      "name": "@nexmarkets/chain"
    },
    "packages/config": {
      "name": "@nexmarkets/config"
    },
    "packages/domain": {
      "name": "@nexmarkets/domain"
    },
    "services/indexer": {
      "name": "@nexmarkets/indexer"
    },
    "services/worker": {
      "name": "@nexmarkets/worker"
    }
  }
}
