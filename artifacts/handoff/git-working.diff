-  root.style.setProperty(&#x27;--theme-chip-border&#x27;, lightTheme ? &#x27;rgba(37, 28, 22, 0.10)&#x27; : &#x27;rgba(255,255,255,0.07)&#x27;);
-  root.style.setProperty(&#x27;--theme-chip-text&#x27;, primary);
