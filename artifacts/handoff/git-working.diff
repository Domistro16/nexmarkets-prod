+const docsArticles=[
+ {id:'what-is-nexmarkets',cat:'start',title:'What NexMarkets is',summary:'A plain explanation of the product, without assuming you already understand Passes or wallet-based buying and resale.',actions:[['Explore Debuts','discover','primary'],['Create a Debut','create']],sections:[
+  ['The simple version',`<p>NexMarkets is a place where a Builder can release a limited Edition around a real product, and where people can get an individual Pass from that Edition.</p><p>The Pass is not just a picture. It has its own serial and it carries the Advantage published for that Edition. An Advantage might be a discount, a period of access, or a number of redemptions. The exact promise should be visible before you buy.</p><div class="nm-k-note"><b>The thing to remember</b><p>Start with the product and the Advantage. The Pass is the object that records your place in that Edition.</p></div>`],
+  ['What happens after the Debut',`<p>If you get a Pass during a Debut, it appears in your Dashboard after the purchase is confirmed. From there you can see what Advantage remains, use it when the Edition allows it, keep the Pass, or list it in the Market.</p><p>If another person later buys that exact Pass, they receive that serial and whatever Advantage remains on it. A used Advantage is not reset just because the Pass changes hands.</p>`],
+  ['What NexMarkets does not promise',`<p>NexMarkets does not promise that a product will succeed, that a Pass will become more valuable, or that someone will buy it from you later. The Market is a way for holders to list and buy exact Passes. It does not mean there will always be a buyer later, and it is not a promise of profit.</p>`]
+ ]},
+ {id:'words-we-use',cat:'start',title:'Debut, Edition, Pass and Advantage',summary:'Four words appear everywhere in NexMarkets. Here is exactly what each one means.',actions:[['Open Discover','discover','primary']],sections:[
+  ['Debut',`<p>A <strong>Debut</strong> is the initial release period for an Edition. Before it opens, the Builder publishes a Preview so people can inspect the product, supply, price, Advantage, network and terms.</p>`],
+  ['Edition',`<p>An <strong>Edition</strong> is the complete limited set being released. If an Edition has 555 Passes, that number is the full supply for that Edition. The Edition also carries shared information such as the product, Pass price during the Debut, Advantage design and Builder Royalty.</p>`],
+  ['Pass',`<p>A <strong>Pass</strong> is one individual item from an Edition. It has its own serial. On the Market, you buy an exact Pass, not a generic copy of the Edition.</p><div class="nm-k-example"><span>Example</span><p>Edition supply: 555 Passes. Your Pass: #102 / 555.</p></div>`],
+  ['Advantage',`<p>An <strong>Advantage</strong> is a commitment the builder makes to every holder. It is honoured by the builder directly, and their profile explains how to claim it. If the builder has integrated our webhook, what you are owed is enforced automatically. The Pass page tells you the amount, duration or number of uses, and what remains.</p>`]
+ ]},
+ {id:'journey-preview-to-owned',cat:'start',title:'From Preview to your Dashboard',summary:'The full holder journey from first inspection to owning and managing an exact Pass.',actions:[['See Discover','discover','primary'],['Open Dashboard','dashboard']],sections:[
+  ['1. Find the Debut',`<p>Discover shows what is opening next and what is already live. Open the product page instead of making a decision from a small card. That page is where the product, Advantage, supply, price and terms come together.</p>`],
+  ['2. Read before you buy',`<p>Check what the product actually does. Read the Advantage in full. Check the Edition size, remaining supply, network and current terms. If something important is unclear, that is a reason to wait.</p>`],
+  ['3. Buy the Pass',`<p>During an open Debut, choose <strong>Get Pass</strong>. NexMarkets shows the amount in USDG and the network before you confirm. Your serial is assigned after the purchase is confirmed.</p>`],
+  ['4. Manage what you own',`<p>The purchased Pass appears under your owned Passes. The Owned page shows your serial, remaining Advantage, current listing state, relevant Market context and history. This is the page to use when you want to redeem, list, change an ask, cancel a listing, or download the Pass image.</p>`]
+ ]},
+ {id:'how-discover-works',cat:'discover',title:'How Discover works',summary:'Use Discover to inspect what is opening, what is live, and which products are worth a closer look.',actions:[['Open Discover','discover','primary']],sections:[
+  ['Opening next and live Debuts',`<p>Discover separates Previews from live Debuts. A Preview gives you time to inspect the offer before buying opens. A live Debut is already accepting purchases.</p><p>Filters help narrow by category, stage, Pass price and Advantage type. Search looks across the product name and Advantage so you can find something specific without scanning every row.</p>`],
+  ['Do not decide from the card alone',`<p>Discover is for finding something worth opening. The full product page is where you should make the decision. It shows the product, the canonical Pass, the Advantage, remaining supply, purchase action and quieter detail below.</p>`]
+ ]},
+ {id:'read-pass-detail',cat:'discover',title:'How to read a Pass page before buying',summary:'A practical checklist for deciding whether to get a Pass during a Debut.',actions:[['Explore Debuts','discover','primary']],sections:[
+  ['Start with the product',`<p>Ask one basic question first: <strong>what is this product and can I inspect what exists?</strong> The Builder can provide a product link, demo, portfolio, GitHub page, documentation or another public source. Use it.</p>`],
+  ['Then read the Advantage',`<p>Do not reduce the Advantage to a large percentage or a headline. Check what it applies to, how long it lasts or how many uses it contains, and whether it is connected automatically or redeemed through NexMarkets.</p>`],
+  ['Check supply and price',`<p>The page shows the Pass price, total Edition supply, how many have been issued and how many remain. Those numbers answer a different question from the Advantage. They tell you how limited the Edition is and whether the Debut is close to selling out.</p>`],
+  ['Read the terms before the action button',`<p>The current terms version belongs with the offer. If the Preview has a terms history, use it to see whether material information changed after the Preview went public.</p>`]
+ ]},
+ {id:'preview-period',cat:'discover',title:'What the Preview period is for',summary:'Why a Debut is shown publicly before purchases open, and what you should inspect during that time.',actions:[['Open Discover','discover','primary']],sections:[
+  ['Time to inspect',`<p>A Preview is not a countdown decoration. It gives people a public window to read what is being offered before the Debut opens. NexMarkets requires a Preview period of at least 24 hours in the current Create flow.</p>`],
+  ['What should already be visible',`<ul><li>The product name and Builder identity.</li><li>A useful description of what exists today.</li><li>The Edition name, supply and Pass price.</li><li>The Advantage and how it works.</li><li>The network.</li><li>The current terms version.</li><li>Public evidence or a product link when the Builder has provided one.</li></ul>`],
+  ['If something changes',`<p>Material changes should not disappear into the page. The product experience includes terms history so a person can compare what was public earlier with what is current now.</p>`]
+ ]},
+ {id:'buy-during-debut',cat:'passes',title:'Buying a Pass during a Debut',summary:'What you confirm, when your serial is assigned, and what happens if the purchase does not complete.',actions:[['Find a live Debut','discover','primary'],['Open Dashboard','dashboard']],sections:[
+  ['Before confirmation',`<p>The purchase sheet should show the exact Pass price in USDG, the network, Edition availability and the Advantage. You are buying one Pass from the Edition. You are not choosing a serial before confirmation unless a specific Edition explicitly says otherwise.</p>`],
+  ['Serial assignment',`<p>Your serial is assigned after the purchase is confirmed. Once the transaction completes, that serial becomes the exact Pass you own.</p>`],
+  ['If the transaction is pending',`<p>Do not repeatedly submit the same purchase because the screen feels slow. Check the wallet and the current NexMarkets state first. A submitted blockchain transaction may still be confirming even if the page has not changed yet.</p>`]
+ ]},
+ {id:'what-you-own',cat:'passes',title:'What owning a Pass means',summary:'The difference between owning the Pass, receiving its Advantage, and owning the Builder product itself.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['You own the exact Pass',`<p>Ownership is tied to an exact serial. Your Dashboard should show that serial, the Edition it belongs to, its remaining Advantage and whether it is listed.</p>`],
+  ['The Advantage belongs with the Pass',`<p>If the Pass carries five redemptions and you use one, four remain. If you later sell the Pass, the buyer gets the remaining four. Ownership does not rewind the history.</p>`],
+  ['You do not automatically own the Builder product or its intellectual property',`<p>A Pass can give access, discounts, redemptions or another stated benefit. It does not automatically give you ownership of the Builder company, product code, brand, artwork copyright or revenue unless the Edition terms explicitly say so.</p>`]
+ ]},
+ {id:'serials',cat:'passes',title:'How Pass serials work',summary:'Why #039 and #102 can have different remaining value even when they belong to the same Edition.',actions:[['Open Market','market','primary']],sections:[
+  ['Every Pass is exact',`<p>The serial identifies one Pass inside an Edition. Two Passes from the same Edition share the same original Edition terms, but their current state can differ after holders use their Advantages.</p>`],
+  ['Why serial state matters in the Market',`<p>When comparing two listings, do not compare ask price alone. One Pass may have its full Advantage while another may have only part of it remaining. The Exact Pass page is designed to show both the market price and the remaining Advantage for that serial.</p>`]
+ ]},
+ {id:'download-share',cat:'passes',title:'Downloading and sharing your exact Pass',summary:'How the exported image stays tied to the Pass you actually own.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['Exact identity',`<p>The download action uses the exact owned Pass, including the correct Edition, serial, artwork and design state. It should not rebuild an unrelated project from whatever happens to be selected elsewhere in the app.</p>`],
+  ['What the image is for',`<p>The PNG is a shareable visual of your Pass. It does not replace the live ownership record or the current Advantage state shown inside NexMarkets.</p>`]
+ ]},
+ {id:'connected-advantage',cat:'advantages',title:'Connected Advantages',summary:'What it means when the benefit is applied by the Builder product instead of redeemed one use at a time.',actions:[['See your Advantages','dashboard','primary']],sections:[
+  ['How it works',`<p>A Connected Advantage is meant to be recognized by the Builder product or service. For example, a Builder may apply a holder discount automatically when the connected wallet is eligible.</p>`],
+  ['What NexMarkets shows',`<p>NexMarkets shows the published Advantage, whether it is still active, and the remaining duration or state available to the Pass. The Builder remains responsible for delivering the product-side benefit it promised.</p>`]
+ ]},
+ {id:'redemption-advantage',cat:'advantages',title:'Redemption Advantages',summary:'How one-use or multi-use benefits are redeemed and why the remaining count matters.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['Using one redemption',`<p>If a Pass has eight redemptions remaining and you use one, the Owned page should make the change clear: eight becomes seven. There is no reward animation because the important thing is the new state.</p>`],
+  ['When you cannot redeem',`<p>Listing a Pass never pauses its Advantage. The commitment stays with the Pass for whoever holds it, and the builder honours it the same way before and after a sale.</p>`]
+ ]},
+ {id:'advantage-transfer',cat:'advantages',title:'What happens to an Advantage when a Pass is sold',summary:'The buyer receives what remains. Used time or redemptions do not reset.',actions:[['Open Market','market','primary']],sections:[
+  ['Remaining state travels with the Pass',`<p>This is one of the most important rules in NexMarkets. If you sell an exact Pass, the buyer receives the Advantage state that remains on that Pass at settlement.</p>`],
+  ['A listing should stay stable',`<p>While the Pass is listed, use is locked. The point is simple: the seller should not be able to spend the Advantage while someone else is deciding whether to buy that exact state.</p>`]
+ ]},
+ {id:'market-overview',cat:'market',title:'How the Market works',summary:'The Market is for exact issued Passes that holders have chosen to list.',actions:[['Open Market','market','primary']],sections:[
+  ['Edition first, exact Pass second',`<p>The Market helps you compare Editions, then inspect individual Passes. The Edition view gives context such as floor and recent sale information. The Exact Pass page is where you decide whether a particular serial is worth its ask.</p>`],
+  ['There is no guaranteed buyer',`<p>A holder can list a Pass at an ask price, but a listing is not a sale. It can remain open, be changed, or be cancelled before anyone buys it.</p>`]
+ ]},
+ {id:'read-exact-pass',cat:'market',title:'How to read an Exact Pass page',summary:'The calm trading view: ask, Edition floor, remaining Advantage, seller, listing age and real price history.',actions:[['Open Market','market','primary']],sections:[
+  ['The decision basics',`<ul><li><strong>Ask</strong>: what the seller wants for this exact Pass.</li><li><strong>Edition floor</strong>: the lowest active ask currently visible for that Edition.</li><li><strong>Remaining Advantage</strong>: what is left on this serial.</li><li><strong>Seller</strong>: the wallet currently offering the Pass.</li><li><strong>Listing age</strong>: how long the current listing has been open.</li></ul>`],
+  ['Use the chart as context, not theatre',`<p>The chart supports multiple time ranges, line or candle views, moving average, floor, volume and ask or floor reference. Prices and chart data stay still unless the underlying data changes. There is no fake movement added to make the Market look busy.</p>`]
+ ]},
+ {id:'floor-ask-last-sale',cat:'market',title:'Floor, ask and last sale',summary:'Three market numbers that answer three different questions.',actions:[['Open Market','market','primary']],sections:[
+  ['Ask',`<p>The ask is the price attached to one active listing. If you buy that exact Pass, this is the seller price you are agreeing to before fees shown in the purchase flow.</p>`],
+  ['Edition floor',`<p>The floor is the lowest active ask in the Edition. It does not tell you whether that lowest Pass has the same remaining Advantage as the one you are viewing.</p>`],
+  ['Last sale',`<p>Last sale is historical. It tells you what a completed sale was recorded at. It does not tell you what a Pass is worth now, and it does not guarantee that another buyer will pay the same amount.</p>`]
+ ]},
+ {id:'buy-exact-pass',cat:'market',title:'Buying an exact listed Pass',summary:'What changes when you buy from another holder instead of during the Debut.',actions:[['Open Market','market','primary'],['Open Dashboard','dashboard']],sections:[
+  ['You are buying that serial',`<p>Secondary purchases are for an exact Pass. Before confirming, check the serial, ask, remaining Advantage and current listing state. If the listing is stale or no longer active, NexMarkets should stop the purchase rather than silently substitute another Pass.</p>`],
+  ['After settlement',`<p>The seller stops being the owner, the buyer becomes the owner, and the buyer receives the remaining Advantage. The purchased Pass should then be available from the buyer Dashboard.</p>`]
+ ]},
+ {id:'list-change-cancel',cat:'market',title:'List a Pass, change the ask, or cancel',summary:'The three owner actions for a Pass you want to offer in the Market.',actions:[['Manage Passes','dashboard','primary'],['Open Market','market']],sections:[
+  ['List',`<p>Choose the Pass from your Owned page or Dashboard, enter the ask, and confirm the listing. Once active, the Owned page should show the listing state clearly instead of making you hunt for it.</p>`],
+  ['Change the ask',`<p>If the Pass is already listed, you can change the ask. Market data should update without moving unrelated prices or pretending there was a sale.</p>`],
+  ['Cancel',`<p>Cancelling the listing keeps the Pass in your ownership. The listing disappears from active Market supply and the Pass becomes available for Advantage use again when the Advantage itself is otherwise eligible.</p>`]
+ ]},
+ {id:'builder-before-create',cat:'builders',title:'Before you create a Debut',summary:'What should exist before you ask people to buy a Pass around it.',actions:[['Create a Debut','create','primary']],sections:[
+  ['Start with something real',`<p>The Create flow begins with the product because the product should come before the Pass. Give people a clear name, a one-line description, a fuller explanation of what it does today, and a public link they can inspect when one exists.</p>`],
+  ['Decide the holder benefit before the artwork',`<p>The most important Builder decision is not the frame or colour of the Pass. It is what the Pass gives its holder and whether the Builder can actually deliver that promise.</p>`]
+ ]},
+ {id:'create-stages',cat:'builders',title:'The six Create stages',summary:'What each stage asks for and why the order matters.',actions:[['Open Create','create','primary']],sections:[
+  ['1. Product',`<p>Name the product, describe it, identify the Builder, show its current state, and add evidence or a public product link.</p>`],
+  ['2. Edition and price',`<p>Set the Edition name, finite supply, Pass price in USDG, network and optional Builder Royalty. NexMarkets shows the maximum amount collected if every Pass is sold and the 5% NexMarkets primary fee.</p>`],
+  ['3. Advantages',`<p>Choose from three optional advantage types: a discount, a referral fee, or a Pass basket. Add none, one, or all three. Each one is a public commitment recorded at publish and honoured by you as the builder.</p>`],
+  ['4. Pass design',`<p>Shape the canonical Pass using the available design system and artwork. The preview is there so the object you publish is the object people later recognize.</p>`],
+  ['5. Preview',`<p>Choose when the Debut opens and publish the public Preview window. The current flow requires at least 24 hours before opening.</p>`],
+  ['6. Review and Publish',`<p>Read the product, Edition, Advantage, design and timing as a holder would. Publish only when the page says exactly what you mean to offer.</p>`]
+ ]},
+ {id:'supply-price-fees',cat:'builders',title:'Supply, price and NexMarkets fees',summary:'How primary Debut economics are calculated and what the Builder sees before publishing.',actions:[['Open Create','create','primary']],sections:[
+  ['Finite supply',`<p>The Edition supply is the exact number of Passes in that release. If you set 555, the Edition is 555 Passes. Treat supply as a product decision, not a marketing decoration.</p>`],
+  ['Pass price',`<p>The Debut price is set in USDG. NexMarkets multiplies price by supply so you can see the maximum amount collected if every Pass is sold.</p>`],
+  ['Primary fee',`<p>The current NexMarkets primary fee is <strong>5%</strong> of the amount collected through the Debut. The Create economics view shows the fee and the amount remaining for the Builder.</p><div class="nm-k-example"><span>Example</span><p>555 Passes at $10 each means $5,550 if every Pass is sold. A 5% NexMarkets fee is $277.50. The remaining $5,272.50 is the Builder amount before any separate obligations the Builder may have.</p></div>`],
+  ['Secondary fee and Builder Royalty',`<p>On secondary sales, NexMarkets charges a <strong>1%</strong> fee. A Builder can also choose a royalty from 0% to 5% for the Edition. The current product holds Builder Royalty for 30 days before it becomes available to withdraw. The Pass itself can still be bought and sold during that period.</p>`]
+ ]},
+ {id:'write-advantage',cat:'builders',title:'How to write an Advantage people can understand',summary:'State the holder benefit as a real promise with an amount, subject and limit.',actions:[['Open Create','create','primary']],sections:[
+  ['Write the sentence a holder needs',`<p>A good Advantage answers three things: <strong>what do I get, where does it apply, and for how long or how many times?</strong></p><div class="nm-k-example"><span>Clear</span><p>40% off NexStudio for 6 months.</p></div><div class="nm-k-example"><span>Also clear</span><p>8 redemptions for the Builder consultation service.</p></div>`],
+  ['Avoid vague promises',`<p>Do not write things like special access, premium community benefits, future benefits, or exclusive opportunities unless you immediately explain what those words mean in practice. If the Builder cannot state the benefit plainly, the holder cannot judge the offer plainly.</p>`]
+ ]},
+ {id:'referral-royalty',cat:'builders',title:'Referrals and Builder Royalty',summary:'Two optional Builder settings that are separate from the holder Advantage.',actions:[['Open Create','create','primary']],sections:[
+  ['Referral reward',`<p>A Builder can turn on a referral reward at one of the supported rates: 5%, 10%, 15% or 20%. NexMarkets records the referral. The Builder is responsible for paying the referral reward.</p>`],
+  ['Builder Royalty',`<p>A Builder can choose a secondary royalty from 0% to 5%. This applies when a Pass from the Edition is resold. The current product places that royalty in a 30-day hold before it can be withdrawn.</p>`],
+  ['Keep them separate in your head',`<p>The Advantage is for the Pass holder. Referral is for the person credited with bringing a buyer. Builder Royalty is for the Builder when a Pass is resold. They are different flows and should not be described as one reward system.</p>`]
+ ]},
+ {id:'preview-terms-history',cat:'builders',title:'Preview, terms version and material changes',summary:'Publish a stable offer people can inspect, and make important changes visible when they happen.',actions:[['Open Create','create','primary']],sections:[
+  ['The Preview is part of the offer',`<p>Once the Preview is public, people may use it to decide whether to return when the Debut opens. Important terms should not quietly change underneath them.</p>`],
+  ['Version the terms',`<p>The Create flow carries a terms version, such as v1.0. The public product page can show terms history so a holder can see the current version and whether material details changed after Preview began.</p>`]
+ ]},
+ {id:'wallet-usdg-network',cat:'wallet',title:'Wallet, USDG and network basics',summary:'What you need to confirm before a Debut purchase or Market trade.',actions:[['Explore Debuts','discover','primary'],['Open Market','market']],sections:[
+  ['Wallet',`<p>Your wallet is how NexMarkets knows which Passes you own and where a purchase should settle. Keep access to it secure. NexMarkets cannot recover a private key or seed phrase for you.</p>`],
+  ['USDG',`<p>Pass purchases in the current product are priced in USDG. The confirmation flow should show the amount before you submit it. Make sure your wallet has enough USDG and enough network gas for the transaction.</p>`],
+  ['Network',`<p>The network is shown with the Pass and transaction. Robinhood Chain is the default network in the current NexMarkets Create flow. Do not assume a Pass can be moved to another network simply because the same product name appears elsewhere.</p>`]
+ ]},
+ {id:'pending-failed',cat:'wallet',title:'Pending, failed or stale transactions',summary:'What to check before clicking again when a purchase or listing does not appear to finish.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['Pending',`<p>A wallet approval and a network confirmation are not the same moment. If you submitted a transaction, check the wallet and give the network state a chance to update before submitting the same action again.</p>`],
+  ['Failed',`<p>If the wallet or network reports a failed transaction, the intended purchase or listing did not settle. Review the reason shown, your balance, any token approval the wallet asks for, and the current listing or Edition state before trying again.</p>`],
+  ['Stale listing',`<p>An exact Pass listing can become stale if ownership or listing state changes. NexMarkets is designed to stop the purchase in that situation rather than buy a different Pass or rely on old information.</p>`]
+ ]},
+ {id:'dashboard-overview',cat:'account',title:'What the Dashboard is for',summary:'The place to see what needs your attention and manage what you already own or launched.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['Action before administration',`<p>The Dashboard puts things that need action ahead of long account summaries. Owned Passes, ready Advantages, active listings, Builder actions and recent activity are organized so you can get to the next task quickly.</p>`],
+  ['Passes',`<p>Use the Passes area to open an owned Pass, use an Advantage, list it, view an active listing, or download the exact PNG.</p>`],
+  ['Advantages and listings',`<p>The Advantages view shows what is ready to use. Listings shows what is currently offered in the Market, the ask and the main management actions.</p>`]
+ ]},
+ {id:'builder-earnings',cat:'account',title:'Builder earnings and the 30-day royalty hold',summary:'Why some Builder money is available now while some is still locked.',actions:[['Open Dashboard','dashboard','primary']],sections:[
+  ['Primary proceeds',`<p>Primary Debut proceeds are separate from Builder Royalty. The Create flow shows the 5% NexMarkets primary fee before you publish so you can see the expected Builder amount if the Edition sells.</p>`],
+  ['Royalty available and locked',`<p>Secondary Builder Royalty is held for 30 days before it becomes available to withdraw. Dashboard earnings should distinguish what is available now from what is still locked and show the remaining wait.</p>`],
+  ['Referral records',`<p>If referrals are enabled, NexMarkets can keep the referral record. The Builder handles the referral payout.</p>`]
+ ]}
+];
+
+const faqGroups=[
+ {title:'The basics',desc:'The words and rules that make everything else easier to understand.',items:[
+  ['What is a Pass?',`<p>A Pass is one exact item from a limited Edition. It has its own serial and carries the Advantage published for that Edition. If the Advantage has already been partly used, the remaining state belongs to that exact Pass.</p>`],
+  ['What is an Edition?',`<p>An Edition is the complete limited release. It defines the supply, the original Debut price, the product, the Advantage and other shared terms.</p>`],
+  ['What is a Debut?',`<p>A Debut is the initial release period when new Passes from an Edition are available. Before it opens, a public Preview lets people inspect the offer.</p>`],
+  ['What is an Advantage?',`<p>An Advantage is the holder benefit attached to the Pass. It can be connected automatically to the Builder product or redeemed through NexMarkets. The page should state the amount, duration or number of uses clearly.</p>`],
+  ['Is a Pass an investment?',`<p>NexMarkets does not promise investment returns. A Pass can be listed and resold, but there may be no buyer and the resale price can be lower or higher than an earlier price. Buy because you understand the product, the Advantage and the terms.</p>`]
+ ]},
+ {title:'Buying and owning',desc:'What happens before, during and after you get a Pass.',items:[
+  ['How do I buy during a Debut?',`<p>Open a live Debut from Discover, read the product page, then choose <strong>Get Pass</strong>. The confirmation shows the Pass price in USDG and the network. Your serial is assigned after the purchase confirms.</p><button class="btn" onclick="go('discover')">Open Discover</button>`],
+  ['Can I choose my serial during a Debut?',`<p>Not in the normal current flow. The next serial is assigned after a successful purchase unless a particular Edition explicitly provides another allocation method.</p>`],
+  ['Where does my Pass appear after purchase?',`<p>In your Dashboard and Owned Pass view after the transaction is confirmed and ownership state updates.</p><button class="btn" onclick="go('dashboard')">Open Dashboard</button>`],
+  ['Can I download the Pass?',`<p>Yes. The Owned page includes Download PNG. The export uses the exact Pass identity, including its serial and Edition design.</p>`],
+  ['Does owning the Pass mean I own the Builder company or product?',`<p>No. Pass ownership does not automatically give you equity, product ownership, copyright, code ownership or control of the Builder business. If an Edition grants a specific right, it needs to be written in that Edition terms.</p>`]
+ ]},
+ {title:'Advantages',desc:'Using the benefit, checking what remains, and understanding transfers.',items:[
+  ['What happens when I use one redemption?',`<p>The remaining count goes down on that exact Pass. If eight redemptions remain and you use one, the new state is seven.</p>`],
+  ['Can I use an Advantage while the Pass is listed?',`<p>Claiming happens with the builder, not in NexMarkets. Open the builder profile from your Pass and follow their instructions. Listing the Pass does not change what the builder owes its holder.</p>`],
+  ['What happens to the Advantage when I sell the Pass?',`<p>The buyer receives what remains. Used redemptions or elapsed benefit do not reset when ownership changes.</p>`],
+  ['What is the difference between Connected and Redemption?',`<p>A Connected Advantage is applied or recognized through the Builder product or service. A Redemption Advantage is used through NexMarkets one use at a time or according to its stated quantity.</p>`],
+  ['Who is responsible for delivering the Advantage?',`<p>The Builder is responsible for the product or service benefit it publishes. NexMarkets records and displays the Pass and Advantage state, and handles the product flows it explicitly controls.</p>`]
+ ]},
+ {title:'Market',desc:'Exact Pass listings, prices and owner actions.',items:[
+  ['What am I buying in the Market?',`<p>An exact listed Pass. Check its serial, ask, remaining Advantage, seller and listing state before confirming.</p><button class="btn" onclick="go('market')">Open Market</button>`],
+  ['What is the Edition floor?',`<p>The lowest active ask currently visible for that Edition. It is not a guarantee of value and it does not mean every Pass has the same remaining Advantage.</p>`],
+  ['What is the ask?',`<p>The seller price for that exact listing.</p>`],
+  ['What does last sale mean?',`<p>It is a recorded completed sale from the past. It is context, not a quote or promise for the next sale.</p>`],
+  ['Can I change my listing price?',`<p>Yes. Open the listed Pass from Owned or Dashboard and choose the price management action. The updated ask should replace the old one without creating a fake sale.</p>`],
+  ['What happens if I cancel a listing?',`<p>The Pass remains yours. It stops being an active Market listing and becomes available for Advantage use again if the Advantage is otherwise eligible.</p>`],
+  ['Does listing guarantee a sale?',`<p>No. A listing is only an offer at your ask. Another person still has to choose that exact Pass and complete the purchase.</p>`]
+ ]},
+ {title:'Builders',desc:'Creating an Edition, setting the economics and publishing a clear offer.',items:[
+  ['What do I need before creating a Debut?',`<p>Start with a real product or service people can understand and inspect. You should be able to explain what exists today, who it is for and what the Pass gives holders.</p>`],
+  ['How much does NexMarkets charge on the Debut?',`<p>The current primary NexMarkets fee is 5% of the amount collected through the Debut. Create shows the maximum amount, the fee and the Builder amount together.</p>`],
+  ['What is the secondary NexMarkets fee?',`<p>The current secondary fee is 1% on a completed Market sale.</p>`],
+  ['Can a Builder set a royalty?',`<p>Yes. The current Create flow supports 0% to 5%. Builder Royalty from a resale is held for 30 days before it becomes available to withdraw.</p>`],
+  ['How do referrals work?',`<p>A Builder can choose 5%, 10%, 15% or 20% when referrals are enabled. NexMarkets keeps the referral record. The Builder handles the payout.</p>`],
+  ['How long is the Preview?',`<p>The current Create flow requires at least 24 hours between the public Preview and Debut opening.</p>`],
+  ['Can I change the terms after Preview begins?',`<p>If material information changes, it should be visible through the terms version and history instead of being silently replaced. People may already be relying on the Preview to decide whether to buy.</p>`]
+ ]},
+ {title:'Wallet and transactions',desc:'The practical things to check when a wallet or network action is involved.',items:[
+  ['What currency do I use?',`<p>The current NexMarkets purchase flow uses USDG for Pass purchases.</p>`],
+  ['Which network does NexMarkets use?',`<p>Robinhood Chain is the default in the current Create flow. The network is shown on Pass and transaction surfaces. Always confirm the network before signing.</p>`],
+  ['What if my transaction is pending?',`<p>Check your wallet first. A transaction can be submitted but still waiting for network confirmation. Avoid submitting the same action repeatedly until you know the first one failed.</p>`],
+  ['Can NexMarkets recover my wallet seed phrase?',`<p>No. Never give a seed phrase or private key to anyone claiming they need it to help with NexMarkets.</p>`],
+  ['Can a blockchain purchase always be reversed?',`<p>No. Do not assume a blockchain transaction can be undone after it has completed. Any refund or remedy for a specific Edition must come from its stated terms or applicable law.</p>`]
+ ]}
+];
+
+const termsSections=[
+ ['about','1. What these Terms cover',`<p>These Terms apply when you use NexMarkets to browse Debuts, get or hold a Pass, use an Advantage, list or buy a Pass in the Market, create an Edition, or use the Dashboard.</p><p>They are written to be readable because the rules matter more when people can understand them. A particular Edition can also have its own published terms. Those Edition terms control the specific product, Advantage, supply and other Edition details. These platform Terms control your use of NexMarkets itself.</p>`],
+ ['eligibility','2. Using NexMarkets',`<p>You are responsible for making sure you are allowed to use NexMarkets and enter the transactions you choose. Do not use the product to break the law, mislead another user, impersonate someone else, manipulate Market activity, or interfere with the service.</p><p>You are also responsible for the wallet you connect. Keep your private keys and seed phrase private. NexMarkets will never need your seed phrase to display or manage a Pass.</p>`],
+ ['passes','3. Passes, Editions and Debuts',`<p>A Debut is the initial release of a limited Edition. A Pass is one exact item from that Edition. Each Pass has its own serial and can carry an Advantage.</p><p>A Pass does not automatically represent equity, debt, a share of Builder revenue, ownership of the Builder business, ownership of product code, or intellectual property rights. If an Edition grants any specific right beyond the stated Advantage, that right must be written clearly in that Edition terms.</p>`],
+ ['advantages','4. Advantages',`<p>An Advantage is the holder benefit published for the Pass. The Builder is responsible for accurately describing the benefit and delivering the product or service side of the promise.</p><p>Some Advantages are connected automatically to a Builder product. Others are redeemed through NexMarkets. When an Advantage is partly used, the remaining state stays with the exact Pass. If the Pass is sold, the buyer receives what remains.</p><p>Advantage use is locked while a Pass is actively listed. This keeps the state a buyer sees from changing underneath an active listing.</p>`],
+ ['preview','5. Previews and Edition information',`<p>Builders publish a Preview before a Debut opens so people can inspect the product, Edition, Advantage and terms. The current Create flow requires a Preview period of at least 24 hours.</p><p>Builders should not hide material changes. NexMarkets can display a terms version and terms history so people can see when important information changed after the Preview became public.</p>`],
+ ['builders','6. Builder responsibilities',`<p>If you create a Debut, you are responsible for the accuracy of the product description, evidence, Edition information, Advantage, opening time, support information and terms you publish.</p><p>Do not publish an Advantage you cannot reasonably deliver. Do not use copied evidence, fake product claims, invented traction, misleading market information or another person's intellectual property without permission.</p><p>If you enable referral rewards, you are responsible for paying them. NexMarkets may keep the referral record, but the current referral flow is Builder settled.</p>`],
+ ['buyers','7. Holder and buyer responsibilities',`<p>Before buying, review the product, Advantage, Edition supply, price, network, current terms and the exact Pass state when buying from the Market.</p><p>You decide whether the purchase makes sense for you. NexMarkets does not promise that a Builder will succeed, that an Advantage will be valuable to you, that a Pass will rise in price, or that you will be able to sell it later.</p>`],
+ ['payments','8. Payment and transaction confirmation',`<p>The current Pass purchase flow uses USDG. The transaction surface shows the amount and network before confirmation.</p><p>Blockchain transactions can take time to confirm and can fail. A wallet confirmation does not always mean the final network state has settled. Do not repeatedly submit the same action until you know the earlier transaction failed.</p><p>After a blockchain transaction completes, it may not be reversible. Do not assume NexMarkets can cancel a settled purchase, restore a transferred Pass, or recover funds sent to the wrong address.</p>`],
+ ['fees','9. Fees and Builder Royalty',`<p>The current NexMarkets primary fee is <strong>5%</strong> of the amount collected through a Debut. The Create flow shows the fee and Builder amount before publication.</p><p>The current NexMarkets secondary fee is <strong>1%</strong> on a completed Market sale. A Builder can also choose a Builder Royalty from 0% to 5% for its Edition.</p><p>Builder Royalty is held for 30 days after a resale before it becomes available for withdrawal. This hold affects royalty withdrawal timing. It does not prevent the Pass itself from being bought or sold during that period.</p><p>Network gas and wallet provider costs are separate from NexMarkets fees and can vary.</p>`],
+ ['market','10. Market listings and resale',`<p>A listing is an offer by a holder to sell an exact Pass at an ask. It is not a guarantee that a sale will happen.</p><p>Market information such as floor, last sale, volume and chart history is provided as transaction context. It is not a promise of value, a forecast, or financial advice.</p><p>A listing can become invalid if ownership, Advantage state or another required condition changes. NexMarkets can reject or stop a stale or invalid listing instead of trying to complete it with old information.</p>`],
+ ['risk','11. Risk and no promise of profit',`<p>Products can fail. Builders can change direction. Advantages can become less useful to you. Markets can be inactive. A Pass can sell for less than you paid, or may not sell at all.</p><p>Do not treat a rising floor, a previous sale or a limited supply as a guarantee of future demand. NexMarkets gives you information to inspect an offer and an exact Pass. The decision remains yours.</p>`],
+ ['ip','12. Content and intellectual property',`<p>Builders keep responsibility for the content and rights they publish. Pass ownership does not transfer copyright, trademark rights, source code, product ownership or other intellectual property unless the specific Edition terms say so.</p><p>You may use NexMarkets interfaces and Pass exports for normal product use and sharing. You may not copy the service, misuse another person's content, or present someone else's Builder identity or Pass artwork as your own.</p>`],
+ ['availability','13. Service availability',`<p>NexMarkets depends on software, wallets, networks and external services that can be delayed or unavailable. We may need to pause a feature to protect users, repair a defect, handle a network issue or prevent an invalid transaction.</p><p>We will try to make state clear when something is pending, unavailable or failed. We do not promise uninterrupted access at every moment.</p>`],
+ ['changes','14. Changes to these Terms',`<p>These Terms can change as NexMarkets changes. When a material platform rule changes, the updated version and effective date should be published so users can read the current rules.</p><p>Edition terms are separate. A Builder changing its Edition terms should use the Edition terms history rather than silently replacing material information.</p>`],
+ ['contact','15. Questions and support',`<p>If you are unsure how a Pass, Advantage, listing or transaction works, read the relevant Docs before confirming the action. If an issue is specific to a Builder product or Advantage delivery, contact the Builder using the support information published for that Edition when available.</p><p>NexMarkets operator contact and formal legal entity details should be published with the production service before these Terms are treated as the final public legal notice. This page deliberately does not invent a company registration, address or governing-law jurisdiction that has not been supplied.</p>`]
+];
+
+function shortcutBar(current){return `<div class="nm-k-top"><div class="nm-k-crumb"><button onclick="go('home')">NexMarkets</button><i></i><span>${D(current)}</span></div><div class="nm-k-shortcuts"><button onclick="go('discover')">Discover</button><button onclick="go('market')">Trade</button><button onclick="go('create')" class="is-primary">Launch a Pass</button></div></div>`}
+function articleById(id){return docsArticles.find(a=>a.id===id)||docsArticles[0]}
+function categoryById(id){return docsCategories.find(c=>c.id===id)||docsCategories[0]}
+function articleSearchText(a){return [a.title,a.summary,categoryById(a.cat).title,...a.sections.flatMap(s=>[s[0],strip(s[1])])].join(' ').toLowerCase()}
+function docsMatches(){const q=docsQuery.trim().toLowerCase();if(!q)return docsArticles;const words=q.split(/\s+/).filter(Boolean);return docsArticles.filter(a=>words.every(w=>articleSearchText(a).includes(w)))}
+function docsSide(activeCat){return `<aside class="nm-k-sidebar">${docsCategories.map(c=>`<div class="nm-k-side-group"><span>${D(c.title)}</span>${docsArticles.filter(a=>a.cat===c.id).map(a=>`<button class="${a.id===docsArticle?'on':''}" onclick="nmOpenDoc('${a.id}')">${D(a.title)}</button>`).join('')}</div>`).join('')}</aside>`}
+function startCards(){const ids=['what-is-nexmarkets','read-pass-detail','read-exact-pass','create-stages'];return ids.map((id,i)=>{const a=articleById(id);return `<button class="nm-k-start-card" onclick="nmOpenDoc('${a.id}')"><span>${String(i+1).padStart(2,'0')}</span><div><b>${D(a.title)}</b><small>${D(a.summary)}</small></div></button>`}).join('')}
+function docsLibrary(){
+ const matches=docsMatches();
+ if(docsQuery.trim()){
+   return `<div class="nm-k-library"><div class="nm-k-results-head"><b>Search results</b><span>${matches.length} ${matches.length===1?'guide':'guides'}</span></div>${matches.length?`<div class="nm-k-guide-list">${matches.map(a=>`<button class="nm-k-guide" onclick="nmOpenDoc('${a.id}')"><div><b>${D(a.title)}</b><p>${D(a.summary)}</p></div><em>→</em></button>`).join('')}</div>`:`<div class="nm-k-no-results"><b>No guide matched that search.</b><p>Try a plain word such as Advantage, listing, USDG, Preview, royalty, serial or redemption.</p></div>`}</div>`
+ }
+ return `<div class="nm-k-library">${docsCategories.map(c=>{const as=docsArticles.filter(a=>a.cat===c.id);return `<section class="nm-k-category" id="docs-cat-${c.id}"><div class="nm-k-category-head"><div><h2>${D(c.title)}</h2><p>${D(c.desc)}</p></div><small>${as.length} ${as.length===1?'guide':'guides'}</small></div><div class="nm-k-guide-list">${as.map(a=>`<button class="nm-k-guide" onclick="nmOpenDoc('${a.id}')"><div><b>${D(a.title)}</b><p>${D(a.summary)}</p></div><em>→</em></button>`).join('')}</div></section>`}).join('')}</div>`
+}
+function docsHome(){return `<div class="nm-k-shell">${shortcutBar('Docs')}<header class="nm-k-hero"><div><span class="nm-k-kicker">NexMarkets Docs</span><h1>Understand it before you use it.</h1><p>Plain explanations for buying a Pass, using an Advantage, reading the Market, launching an Edition, and dealing with the wallet or network when something does not go as expected.</p></div><label class="nm-k-search">${searchIcon}<input id="nmDocsSearch" type="search" value="${D(docsQuery)}" placeholder="Search Passes, Advantages, listings, fees, USDG..." autocomplete="off"><kbd>/</kbd></label></header>${docsQuery.trim()?'':`<section class="nm-k-start" id="nmDocsStart"><div class="nm-k-section-title"><h2>Start with what you are trying to do</h2><span>Four useful entry points</span></div><div class="nm-k-start-grid">${startCards()}</div></section>`}<div class="nm-k-doc-layout">${docsSide('')}<main id="nmDocsLibrary">${docsLibrary()}</main></div></div>`}
+function docActions(a){if(!a.actions?.length)return '';return `<div class="nm-k-actions">${a.actions.map(x=>`<button class="${x[2]==='primary'?'primary':''}" onclick="go('${x[1]}')">${D(x[0])}</button>`).join('')}</div>`}
+function docsArticlePage(a){const cat=categoryById(a.cat);const sectionIds=a.sections.map(s=>slug(s[0]));return `<div class="nm-k-article-wrap">${shortcutBar('Docs')}<header class="nm-k-article-head"><span>${D(cat.title)}</span><h1>${D(a.title)}</h1><p>${D(a.summary)}</p></header><div class="nm-k-article-grid"><aside class="nm-k-article-nav"><b>Docs</b><button onclick="nmDocsHome()">← All guides</button><button onclick="go('faq')">FAQ</button><button onclick="go('terms')">Terms</button></aside><article class="nm-k-article">${a.sections.map((s,i)=>`<section id="${sectionIds[i]}"><h2>${D(s[0])}</h2>${s[1]}${i===a.sections.length-1?docActions(a):''}</section>`).join('')}</article><aside class="nm-k-toc"><b>On this page</b>${a.sections.map((s,i)=>`<a href="#${sectionIds[i]}">${D(s[0])}</a>`).join('')}</aside></div></div>`}
+function bindDocsSearch(){const input=document.getElementById('nmDocsSearch');if(!input)return;input.addEventListener('input',e=>{docsQuery=e.target.value;const start=document.getElementById('nmDocsStart');if(start)start.hidden=!!docsQuery.trim();const lib=document.getElementById('nmDocsLibrary');if(lib)lib.innerHTML=docsLibrary()});input.addEventListener('keydown',e=>{if(e.key==='Escape'){docsQuery='';input.value='';const start=document.getElementById('nmDocsStart');if(start)start.hidden=false;const lib=document.getElementById('nmDocsLibrary');if(lib)lib.innerHTML=docsLibrary()}})}
+window.renderDocsPage=function(){const m=document.getElementById('nmDocsMount');if(!m)return;m.innerHTML=docsArticle?docsArticlePage(articleById(docsArticle)):docsHome();if(!docsArticle)bindDocsSearch()};
