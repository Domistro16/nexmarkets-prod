.pack-back .back-auth-seal{width:26px;height:26px;right:11px;bottom:10px}\n}\n\n\n/* ==========================================================\n   V28.2 TRUE PERIMETER REBUILD\n   Reverts the failed overlay-ring approach. The approved face\n   remains intact; the physical edge lives OUTSIDE it as the\n   exposed pack chassis. Front and reverse share the same edge.\n   ========================================================== */\n\n/* Keep actual 3D thickness substantial without painting over the face. */\n.pack{--edge-w:10px;--inner-r:16px;background:#15191d;box-shadow:inset 0 1px 0 rgba(255,255,255,.12),inset 0 -2px 0 rgba(0,0,0,.48);}\n.pack .depth{transform:translateZ(-22px);box-shadow:0 0 0 1px rgba(0,0,0,.78),inset 0 0 20px rgba(255,255,255,.035),0 18px 28px rgba(0,0,0,.22)}\n.pack>.face{inset:var(--edge-w);border-radius:var(--inner-r);}\n\n/* 01 \u2014 Graded slab: thick cold smoked chassis, not a decorative stripe. */\n.pack-slab{--edge-w:11px;--inner-r:20px;background:\n  linear-gradient(138deg,rgba(255,255,255,.15) 0%,rgba(255,255,255,.045) 16%,transparent 34%),\n  linear-gradient(318deg,rgba(0,0,0,.55) 0%,transparent 36%),\n  linear-gradient(148deg,#343a40 0%,#24292e 24%,#151a1f 53%,#282e34 78%,#11151a 100%);\n  box-shadow:inset 0 3px 0 rgba(255,255,255,.16),inset 2px 0 0 rgba(255,255,255,.055),inset -2px 0 0 rgba(0,0,0,.48),inset 0 -3px 0 rgba(0,0,0,.62),0 6px 15px rgba(0,0,0,.18)}\n.pack-slab .depth{background:linear-gradient(90deg,#090c0f,#343b43 13%,#5f6871 27%,#242a30 48%,#171b20 55%,#30373e 74%,#11151a 100%)}\n\n/* 02 \u2014 Museum glass: dark vitrine chassis with a restrained warm metal seam. */\n.pack-glass{--edge-w:12px;--inner-r:13px;background:\n  linear-gradient(145deg,rgba(232,242,249,.12),transparent 19%),\n  linear-gradient(315deg,rgba(0,0,0,.58),transparent 34%),\n  linear-gradient(145deg,#262c32 0%,#15191e 38%,#090c10 70%,#1f242a 100%);\n  box-shadow:inset 0 2px 0 rgba(230,240,247,.12),inset 0 0 0 1px rgba(199,173,119,.18),inset 0 0 0 4px rgba(0,0,0,.20),inset 0 -3px 0 rgba(0,0,0,.64)}\n.pack-glass .depth{background:linear-gradient(145deg,#0a0d11,#262c33 46%,#090b0e)}\n\n/* 03 \u2014 Machined metal: broad directional machining, no vertical UI striping. */\n.pack-metal{--edge-w:12px;--inner-r:15px;background:\n  linear-gradient(136deg,rgba(255,255,255,.30) 0%,rgba(255,255,255,.08) 14%,transparent 34%),\n  linear-gradient(316deg,rgba(0,0,0,.58) 0%,transparent 38%),\n  linear-gradient(155deg,#929aa2 0%,#59616a 13%,#30363d 31%,#171c21 55%,#414951 76%,#20262c 100%);\n  box-shadow:inset 0 3px 0 rgba(255,255,255,.26),inset 2px 0 0 rgba(255,255,255,.09),inset -3px 0 0 rgba(0,0,0,.40),inset 0 -4px 0 rgba(0,0,0,.62),inset 0 0 0 1px rgba(255,255,255,.10),0 6px 18px rgba(0,0,0,.20)}\n.pack-metal .depth{background:linear-gradient(90deg,#080a0c,#4d555e 14%,#7d858e 25%,#2c3238 45%,#151a1f 57%,#555e66 77%,#11151a 100%)}\n\n/* 04 \u2014 Ceramic: a raised glazed rim, soft and continuous. */\n.pack-ceramic{--edge-w:11px;--inner-r:23px;background:\n  radial-gradient(circle at 24% 9%,rgba(255,255,255,.40),transparent 17%),\n  linear-gradient(148deg,color-mix(in srgb,var(--p) 68%,white) 0%,color-mix(in srgb,var(--p) 91%,white) 22%,var(--p) 53%,color-mix(in srgb,var(--p) 68%,#14171a) 100%);\n  box-shadow:inset 0 3px 0 rgba(255,255,255,.34),inset 2px 0 0 rgba(255,255,255,.12),inset -2px 0 0 rgba(0,0,0,.13),inset 0 -5px 7px rgba(0,0,0,.19),0 7px 18px rgba(0,0,0,.18)}\n.pack-ceramic .depth{background:linear-gradient(145deg,color-mix(in srgb,var(--p) 62%,#1c2023),#0f1215)}\n\n/* 05 \u2014 Blister: thick die-cut board edge, not a metal bezel. */\n.pack-blister{--edge-w:8px;--inner-r:12px;background:\n  linear-gradient(90deg,rgba(255,255,255,.34),transparent 5%,transparent 95%,rgba(80,52,31,.16)),\n  linear-gradient(180deg,color-mix(in srgb,var(--s) 12%,#fff9ef),color-mix(in srgb,var(--s) 30%,#d6c5ad));\n  box-shadow:inset 0 2px 0 rgba(255,255,255,.42),inset 0 0 0 1px rgba(119,79,47,.18),inset 0 -3px 5px rgba(81,52,31,.14),0 5px 14px rgba(0,0,0,.15)}\n.pack-blister .depth{background:linear-gradient(145deg,#6e5841,#2b2118)}\n\n/* 06 \u2014 Forged carbon: perimeter carries the weave and directional resin sheen. */\n.pack-carbon{--edge-w:11px;--inner-r:14px;background:\n  linear-gradient(136deg,rgba(255,255,255,.12) 0%,rgba(255,255,255,.035) 17%,transparent 34%),\n  repeating-linear-gradient(45deg,#171b20 0 4px,#0c0f13 4px 8px,#20252a 8px 12px,#101318 12px 16px),\n  repeating-linear-gradient(-45deg,rgba(255,255,255,.025) 0 4px,transparent 4px 8px);\n  box-shadow:inset 0 2px 0 rgba(255,255,255,.13),inset 2px 0 0 rgba(255,255,255,.045),inset -2px 0 0 rgba(0,0,0,.52),inset 0 -4px 0 rgba(0,0,0,.66),0 7px 18px rgba(0,0,0,.22)}\n.pack-carbon .depth{background:linear-gradient(145deg,#07090c,#1b2025 47%,#080b0e)}\n\n/* 07 \u2014 Archive certificate: laminated/deckled paper thickness, never a hard metal frame. */\n.pack-paper{--edge-w:7px;--inner-r:5px;background:\n  repeating-linear-gradient(0deg,rgba(81,54,31,.045) 0 1px,transparent 1px 3px),\n  linear-gradient(90deg,rgba(255,255,255,.20),transparent 7%,transparent 92%,rgba(75,49,29,.18)),\n  linear-gradient(180deg,color-mix(in srgb,var(--p) 54%,#ead8b5),color-mix(in srgb,var(--p) 76%,#9d7950));\n  box-shadow:inset 0 1px 0 rgba(255,255,255,.34),inset 0 0 0 1px rgba(92,61,34,.28),inset 0 -3px 4px rgba(76,49,27,.16),0 5px 13px rgba(0,0,0,.15)}\n.pack-paper .depth{background:linear-gradient(145deg,#7b5b3a,#3b291b)}\n\n/* 08 \u2014 Cast resin: thick translucent cast perimeter with real edge catch. */\n.pack-resin{--edge-w:12px;--inner-r:15px;background:\n  linear-gradient(133deg,rgba(233,247,253,.27) 0%,rgba(210,235,246,.10) 16%,transparent 35%),\n  linear-gradient(315deg,rgba(4,14,20,.42) 0%,transparent 38%),\n  linear-gradient(145deg,color-mix(in srgb,var(--p) 42%,#7197aa),color-mix(in srgb,var(--p) 58%,#294657) 34%,color-mix(in srgb,var(--p) 37%,#10232e) 72%,#0b151c);\n  box-shadow:inset 0 3px 0 rgba(237,249,253,.24),inset 3px 0 0 rgba(231,247,252,.10),inset -3px 0 0 rgba(0,0,0,.20),inset 0 -5px 7px rgba(0,0,0,.25),inset 0 0 15px rgba(255,255,255,.045),0 7px 20px rgba(0,0,0,.20)}\n.pack-resin .depth{background:linear-gradient(145deg,color-mix(in srgb,var(--p) 28%,#182b36),#091117)}\n\n/* The reverse is the same physical object: never change perimeter on flip. */\n.object-flipper>.pack-front,.object-flipper>.pack-back{background-clip:border-box}\n\n/* Maintain usable proportions on small screens. */\n@media(max-width:700px){\n  .pack-slab{--edge-w:9px}.pack-glass{--edge-w:10px}.pack-metal{--edge-w:10px}.pack-ceramic{--edge-w:9px}\n  .pack-blister{--edge-w:7px}.pack-carbon{--edge-w:9px}.pack-paper{--edge-w:6px}.pack-resin{--edge-w:10px}\n}\n\n\n/* ==========================================================\n   V28.3 EDGE AUTHORITY PATCH\n   Bring the perimeter closer to the v5.1 metal-glow standard:\n   real bezel width, directional bevel logic, strong recess and\n   believable mass. Faces/backs remain unchanged.\n   ========================================================== */\n\n.pack{\n  --edge-w:14px;\n  --inner-r:16px;\n  --edge-hi:rgba(255,255,255,.16);\n  --edge-left:rgba(255,255,255,.06);\n  --edge-right:rgba(0,0,0,.48);\n  --edge-bottom:rgba(0,0,0,.66);\n  --edge-ring:rgba(0,0,0,.10);\n  --edge-cast-1:rgba(0,0,0,.44);\n  --edge-cast-2:rgba(0,0,0,.58);\n  --edge-cast-3:rgba(0,0,0,.42);\n  --edge-cast-4:rgba(0,0,0,.28);\n  isolation:isolate;\n}\n.pack::before,.pack::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none}\n.pack::before{\n  z-index:1;\n  background:\n    linear-gradient(138deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,.05) 18%,transparent 38%),\n    linear-gradient(318deg,rgba(0,0,0,.46) 0%,transparent 40%);\n}\n.pack::after{\n  z-index:1;\n  box-shadow:\n    inset 0 3px 0   var(--edge-hi),\n    inset 0 1.5px 0 rgba(255,255,255,.08),\n    inset 2.5px 0 0 var(--edge-left),\n    inset -2.5px 0 0 var(--edge-right),\n    inset 0 -4px 0  var(--edge-bottom),\n    inset 0 0 0 calc(var(--edge-w) + 1px) var(--edge-ring);\n}\n.pack>.face{inset:var(--edge-w);border-radius:var(--inner-r)}\n.pack .depth{\n  transform:translateZ(-24px);\n  box-shadow:\n    0 2px 6px var(--edge-cast-1),\n    0 12px 30px var(--edge-cast-2),\n    0 34px 74px var(--edge-cast-3),\n    0 74px 128px var(--edge-cast-4);\n}\n\n/* 01 \u2014 slab: cold machined black/acrylic chassis. */\n.pack-slab{--edge-w:16px;--inner-r:19px;--edge-hi:rgba(255,255,255,.18);--edge-left:rgba(255,255,255,.08);--edge-right:rgba(0,0,0,.52);--edge-bottom:rgba(0,0,0,.72);--edge-ring:rgba(0,0,0,.11);background:\n  linear-gradient(138deg,rgba(255,255,255,.13) 0%,rgba(255,255,255,.05) 19%,transparent 38%),\n  linear-gradient(148deg,#383d43 0%,#2a2f34 17%,#1c2126 39%,#171b20 56%,#24292f 77%,#31373d 100%);\n  box-shadow:0 3px 8px rgba(0,0,0,.42),0 12px 30px rgba(0,0,0,.56),0 36px 82px rgba(0,0,0,.46),0 78px 136px rgba(0,0,0,.30)}\n.pack-slab .depth{background:linear-gradient(90deg,#0a0d10,#363d46 15%,#606871 28%,#252b31 49%,#161b20 56%,#30363e 75%,#101419 100%)}\n\n/* 02 \u2014 museum glass: deep vitrine shell with bronze seam. */\n.pack-glass{--edge-w:15px;--inner-r:12px;--edge-hi:rgba(231,238,244,.14);--edge-left:rgba(255,255,255,.05);--edge-right:rgba(0,0,0,.58);--edge-bottom:rgba(0,0,0,.74);--edge-ring:rgba(0,0,0,.12);background:\n  linear-gradient(140deg,rgba(255,255,255,.11) 0%,rgba(255,255,255,.03) 18%,transparent 36%),\n  linear-gradient(145deg,#252c33 0%,#171c21 34%,#0a0d11 68%,#22282f 100%);\n  box-shadow:0 4px 10px rgba(0,0,0,.44),0 13px 32px rgba(0,0,0,.58),0 38px 84px rgba(0,0,0,.48),0 82px 140px rgba(0,0,0,.30)}\n.pack-glass::after{box-shadow:inset 0 3px 0 rgba(232,240,247,.15),inset 0 1.5px 0 rgba(255,255,255,.07),inset 2.5px 0 0 rgba(255,255,255,.05),inset -2.5px 0 0 rgba(0,0,0,.58),inset 0 -4px 0 rgba(0,0,0,.72),inset 0 0 0 1px rgba(187,154,102,.20),inset 0 0 0 calc(var(--edge-w) + 1px) rgba(0,0,0,.12)}\n.pack-glass .depth{background:linear-gradient(145deg,#090d11,#2a3038 46%,#080b0e)}\n\n/* 03 \u2014 metal: v5.1-level machined collector edge. */\n.pack-metal{--edge-w:16px;--inner-r:15px;--edge-hi:rgba(255,255,255,.26);--edge-left:rgba(255,255,255,.09);--edge-right:rgba(0,0,0,.44);--edge-bottom:rgba(0,0,0,.64);--edge-ring:rgba(0,0,0,.11);background:\n  linear-gradient(136deg,rgba(255,255,255,.30) 0%,rgba(255,255,255,.08) 14%,transparent 34%),\n  linear-gradient(155deg,#9aa2aa 0%,#64707a 12%,#394047 30%,#1a1f25 55%,#49515a 76%,#21272d 100%);\n  box-shadow:0 4px 10px rgba(0,0,0,.46),0 14px 34px rgba(0,0,0,.60),0 40px 88px rgba(0,0,0,.50),0 86px 148px rgba(0,0,0,.34)}\n.pack-metal::after{box-shadow:inset 0 4px 0 rgba(255,255,255,.28),inset 0 1.5px 0 rgba(255,255,255,.12),inset 3px 0 0 rgba(255,255,255,.10),inset -3px 0 0 rgba(0,0,0,.44),inset 0 -4px 0 rgba(0,0,0,.68),inset 0 0 0 calc(var(--edge-w) + 2px) rgba(0,0,0,.11)}\n.pack-metal .depth{background:linear-gradient(90deg,#080a0c,#505861 14%,#838b94 25%,#2f353b 45%,#171c21 57%,#586169 77%,#11151a 100%)}\n\n/* 04 \u2014 ceramic: thickness through glazed raised rim, not metal. */\n.pack-ceramic{--edge-w:13px;--inner-r:22px;--edge-hi:rgba(255,255,255,.32);--edge-left:rgba(255,255,255,.13);--edge-right:rgba(0,0,0,.15);--edge-bottom:rgba(0,0,0,.20);--edge-ring:rgba(0,0,0,.06);background:\n  radial-gradient(circle at 24% 9%,rgba(255,255,255,.42),transparent 18%),\n  linear-gradient(148deg,color-mix(in srgb,var(--p) 70%,white) 0%,color-mix(in srgb,var(--p) 92%,white) 22%,var(--p) 53%,color-mix(in srgb,var(--p) 70%,#171b1e) 100%);\n  box-shadow:0 3px 8px rgba(0,0,0,.24),0 10px 24px rgba(0,0,0,.26),0 28px 60px rgba(0,0,0,.22)}\n.pack-ceramic::after{box-shadow:inset 0 4px 0 rgba(255,255,255,.34),inset 0 1.5px 0 rgba(255,255,255,.16),inset 2px 0 0 rgba(255,255,255,.12),inset -2px 0 0 rgba(0,0,0,.13),inset 0 -5px 8px rgba(0,0,0,.18),inset 0 0 0 calc(var(--edge-w) + 1px) rgba(255,255,255,.05)}\n.pack-ceramic .depth{background:linear-gradient(145deg,color-mix(in srgb,var(--p) 62%,#1c2023),#0f1215)}\n\n/* 05 \u2014 blister: heavier printed board perimeter with realistic depth. */\n.pack-blister{--edge-w:11px;--inner-r:11px;--edge-hi:rgba(255,255,255,.34);--edge-left:rgba(255,255,255,.16);--edge-right:rgba(87,58,34,.16);--edge-bottom:rgba(88,58,35,.22);--edge-ring:rgba(92,60,36,.08);background:\n  linear-gradient(90deg,rgba(255,255,255,.36),transparent 5%,transparent 95%,rgba(80,52,31,.18)),\n  linear-gradient(180deg,color-mix(in srgb,var(--s) 12%,#fff9ef),color-mix(in srgb,var(--s) 30%,#d6c5ad));\n  box-shadow:0 3px 8px rgba(0,0,0,.18),0 10px 24px rgba(0,0,0,.16),0 24px 52px rgba(0,0,0,.12)}\n.pack-blister::after{box-shadow:inset 0 2px 0 rgba(255,255,255,.42),inset 0 1px 0 rgba(255,255,255,.20),inset 2px 0 0 rgba(255,255,255,.14),inset -2px 0 0 rgba(126,85,50,.12),inset 0 -3px 5px rgba(81,52,31,.14),inset 0 0 0 calc(var(--edge-w) + 1px) rgba(119,79,47,.10)}\n.pack-blister .depth{background:linear-gradient(145deg,#7b6349,#2d2319)}\n\n/* 06 \u2014 carbon: borrow v5.1 carbon realism directly. */\n.pack-carbon{--edge-w:15px;--inner-r:13px;--edge-hi:rgba(255,255,255,.20);--edge-left:rgba(255,255,255,.08);--edge-right:rgba(0,0,0,.56);--edge-bottom:rgba(0,0,0,.72);--edge-ring:rgba(0,0,0,.10);background:\n  linear-gradient(138deg,rgba(255,255,255,.13) 0%,rgba(255,255,255,.05) 20%,transparent 40%),\n  repeating-linear-gradient(0deg,rgba(255,255,255,.028) 0px,rgba(255,255,255,.028) 1px,transparent 1px,transparent 7px),\n  repeating-linear-gradient(45deg,rgba(0,0,0,.62) 0px,rgba(0,0,0,.62) 3.5px,rgba(255,255,255,.065) 3.5px,rgba(255,255,255,.065) 7px),\n  repeating-linear-gradient(-45deg,rgba(0,0,0,.50) 0px,rgba(0,0,0,.50) 3.5px,rgba(255,255,255,.032) 3.5px,rgba(255,255,255,.032) 7px),\n  linear-gradient(148deg,#22232c 0%,#181820 38%,#0f1014 58%,#1c1d26 100%);\n  box-shadow:0 3px 12px rgba(0,0,0,.60),0 14px 40px rgba(0,0,0,.70),0 48px 98px rgba(0,0,0,.62),0 88px 148px rgba(0,0,0,.52)}\n.pack-carbon::after{box-shadow:inset 0 3px 0 rgba(255,255,255,.20),inset 0 1px 0 rgba(