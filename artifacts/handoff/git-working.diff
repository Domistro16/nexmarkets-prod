1px 0 rgba(255,255,255,.16)}.pack-gilt .v27-folio-head small{color:#785337}\n.pack-gilt .v27-folio-rule{left:30%;right:25%;top:23.5%;background:linear-gradient(90deg,transparent,rgba(91,61,35,.45),transparent)}\n.pack-gilt .artwell{left:20.5%;right:17.8%;top:28.1%;border:6px solid rgba(96,65,38,.3);box-shadow:0 0 0 1px rgba(255,255,255,.28),0 0 0 3px rgba(77,49,27,.045),0 8px 14px rgba(70,45,25,.14)}\n.pack-gilt .v27-folio-caption{top:70.4%;color:#765238}\n.pack-gilt .v27-folio-note{left:14%;right:12%;top:73.8%;height:9%;border-top-color:rgba(80,53,30,.22)}.pack-gilt .v27-folio-note b{color:#744f35}.pack-gilt .v27-folio-note p{color:#4b3321}\n.pack-gilt .v27-folio-stamp{right:9.4%;bottom:6.7%;width:12.8%;border-color:color-mix(in srgb,var(--p) 70%,#7a3429);color:color-mix(in srgb,var(--p) 78%,#733228);background:color-mix(in srgb,var(--p) 3%,transparent);opacity:.82}\n.pack-gilt .v27-folio-reg{left:14%;right:24.5%;bottom:7%;color:#5a3d29;border-top-color:rgba(81,54,31,.2)}\n@media(max-width:700px){.pack-paper .v27-deed-foot{right:22%;height:4.6%}.pack-paper .v27-foot-reg{font-size:4.7px;padding-top:5px}.pack-gilt .v27-folio-head .v13-title{font-size:12.8px}.pack-gilt .v27-folio-spine{width:10px}.pack-gilt .v27-folio-stamp{width:11.8%}}\n\n\n\n/* Upload layer \u2014 additive only; approved pack geometry remains untouched. */\n.asset-upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}\n.asset-upload{display:block;padding:9px;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:#0f1218;min-width:0}\n.asset-upload>span{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#a2acb7;margin-bottom:6px}\n.asset-upload input[type=file]{display:block;width:100%;max-width:100%;font-size:9px;color:#cbd2da}\n.asset-upload input[type=file]::file-selector-button{margin-right:7px;padding:6px 8px;border:1px solid rgba(255,255,255,.09);border-radius:8px;background:#171c23;color:#e9edf1;font-size:9px;cursor:pointer}\n.asset-upload small{display:block;margin-top:5px;font-size:8px;line-height:1.3;color:#747f8b}\n.uploaded-logo-mark{display:block;width:76%;height:76%;object-fit:contain;object-position:center}\n.uploaded-logo-inline{display:inline-flex;align-items:center;justify-content:center;height:1.15em;max-width:42px;margin-right:.32em;vertical-align:-.12em}\n.uploaded-logo-inline img{display:block;height:100%;width:auto;max-width:42px;object-fit:contain}\n@media(max-width:720px){.asset-upload-grid{grid-template-columns:1fr}}\n.export-png-btn{width:100%;margin-top:10px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:linear-gradient(180deg,#1a2028,#11161c);color:#f3f5f7;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 7px 16px rgba(0,0,0,.16)}\n.export-png-btn:hover{background:linear-gradient(180deg,#222a34,#151b22);border-color:rgba(255,255,255,.2)}\n.export-png-btn:disabled{opacity:.55;cursor:wait}\n.export-note{margin-top:7px;font-size:8px;line-height:1.35;color:#747f8b}\n\n\n\n/* =========================================================\n   V28 MATERIAL AUTHORITY + PHYSICAL REVERSE\n   Layout geometry of the eight approved fronts is unchanged.\n   This layer upgrades material response only and adds a true reverse.\n   ========================================================= */\n\n/* Whole-object front / reverse architecture. */\n.object-flipper{position:absolute;inset:0;transform-style:preserve-3d;transition:transform 760ms cubic-bezier(.18,.78,.18,1);will-change:transform}\n.object[data-side=\"back\"] .object-flipper{transform:rotateY(180deg)}\n.object-flipper>.pack{backface-visibility:hidden;-webkit-backface-visibility:hidden}\n.object-flipper>.pack-front{transform:rotateY(0deg) translateZ(.2px)}\n.object-flipper>.pack-back{transform:rotateY(180deg) translateZ(.2px)}\n\n.side-toggle-wrap{margin-top:10px;padding:9px;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:#0f1218}\n.side-toggle-label{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#a2acb7;margin-bottom:7px}\n.side-toggle{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.side-btn{padding:8px 9px;border-radius:9px;border:1px solid rgba(255,255,255,.08);background:#151a21;color:#aeb7c1;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}\n.side-btn.active{background:color-mix(in srgb,var(--p) 42%,#171c23);border-color:color-mix(in srgb,var(--p) 60%,rgba(255,255,255,.2));color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}\n\n/* ---------- Selective donor techniques from v5.1: material physics only. ---------- */\n/* Slab: cold directional edge specular + recessed face contact. */\n.pack-front.pack-slab .depth{background:linear-gradient(138deg,rgba(255,255,255,.12),transparent 22%),linear-gradient(90deg,#0d1115 0%,#2b3239 10%,#3b434b 18%,#252b31 30%,#20262c 50%,#252b31 70%,#3b434b 82%,#2b3239 90%,#0d1115 100%)}\n.pack-front.pack-slab .face{box-shadow:inset 0 3px 0 rgba(255,255,255,.13),inset 2px 0 0 rgba(255,255,255,.055),inset -2px 0 0 rgba(0,0,0,.25),inset 0 -3px 0 rgba(0,0,0,.42),inset 0 0 0 4px rgba(255,255,255,.032),inset 0 0 16px rgba(255,255,255,.025),0 18px 34px rgba(0,0,0,.24)}\n.pack-front.pack-slab .artwell{box-shadow:0 0 0 2px rgba(0,0,0,.82),0 0 22px rgba(0,0,0,.75),0 10px 22px rgba(0,0,0,.38)}\n\n/* Museum glass: Fresnel edge, bright top/left, deep underside. */\n.pack-front.pack-glass .face{box-shadow:inset 0 3px 0 rgba(235,248,255,.14),inset 2px 0 0 rgba(235,248,255,.07),inset -3px 0 0 rgba(0,0,0,.34),inset 0 -3px 0 rgba(0,0,0,.52),inset 0 0 0 7px color-mix(in srgb,var(--p) 34%,#1f242a),inset 0 0 0 10px rgba(255,255,255,.08),inset 0 0 0 22px #090c10,0 20px 40px rgba(0,0,0,.46)}\n.pack-front.pack-glass .face::before{opacity:.18;background:radial-gradient(circle at var(--gx) var(--gy),rgba(236,248,255,.22),transparent 18%),linear-gradient(124deg,rgba(255,255,255,.11),transparent 18% 70%,rgba(255,255,255,.025)),linear-gradient(180deg,rgba(255,255,255,.04),transparent 18% 82%,rgba(0,0,0,.08))}\n\n/* Metal: watch-case light logic without changing the approved geometry. */\n.pack-front.pack-metal .face{box-shadow:inset 0 3px 0 rgba(255,255,255,.22),inset 2.5px 0 0 rgba(255,255,255,.09),inset -2.5px 0 0 rgba(0,0,0,.46),inset 0 -3.5px 0 rgba(0,0,0,.62),inset 0 0 0 5px rgba(255,255,255,.09),inset 0 0 0 18px rgba(0,0,0,.15),inset 0 0 24px rgba(0,0,0,.43)}\n.pack-front.pack-metal .v13-metal-head,.pack-front.pack-metal .v13-metal-foot{box-shadow:inset 0 1px 0 rgba(255,255,255,.08),inset 0 -1px 0 rgba(0,0,0,.22),0 7px 14px rgba(0,0,0,.12)}\n\n/* Ceramic: glaze response only; no metal texture imported. */\n.pack-front.pack-ceramic .face{box-shadow:inset 0 3px 0 rgba(255,255,255,.24),inset 2px 0 0 rgba(255,255,255,.08),inset -2px 0 0 rgba(0,0,0,.16),inset 0 -4px 0 rgba(0,0,0,.22),inset 0 0 0 8px rgba(255,255,255,.13),inset 0 -22px 30px rgba(0,0,0,.18),0 26px 54px rgba(0,0,0,.42)}\n.pack-front.pack-ceramic .face::before{opacity:.28;background:radial-gradient(circle at var(--gx) var(--gy),rgba(255,255,255,.30),transparent 19%),radial-gradient(circle at 24% 12%,rgba(255,255,255,.19),transparent 14%),linear-gradient(135deg,rgba(255,255,255,.05),transparent 46%)}\n\n/* Blister: plastic optics, not metal-edge theming. */\n.pack-front.pack-blister .v27-blister-chamber{box-shadow:inset 2px 0 0 rgba(255,255,255,.36),inset -2px 0 0 rgba(98,68,45,.08),inset 0 3px 0 rgba(255,255,255,.32),inset 0 -8px 18px rgba(104,73,49,.06),0 14px 24px rgba(73,45,26,.16)}\n.pack-front.pack-blister .v27-chamber-glint{opacity:.58;background:linear-gradient(180deg,rgba(255,255,255,.46),rgba(255,255,255,.05) 54%,transparent)}\n\n/* Carbon: true twill weave + cold specular, preserving all positions. */\n.pack-front.pack-carbon .face{background:linear-gradient(138deg,rgba(255,255,255,.12),transparent 23%),repeating-linear-gradient(0deg,rgba(255,255,255,.022) 0 1px,transparent 1px 7px),repeating-linear-gradient(45deg,rgba(0,0,0,.58) 0 3.5px,rgba(255,255,255,.058) 3.5px 7px),repeating-linear-gradient(-45deg,rgba(0,0,0,.46) 0 3.5px,rgba(255,255,255,.028) 3.5px 7px),linear-gradient(148deg,#22232c 0%,#181820 38%,#0f1014 58%,#1c1d26 100%);box-shadow:inset 0 3px 0 rgba(255,255,255,.17),inset 2px 0 0 rgba(255,255,255,.06),inset -2px 0 0 rgba(0,0,0,.5),inset 0 -3px 0 rgba(0,0,0,.66),inset 0 0 0 4px rgba(255,255,255,.03),inset 0 0 0 17px rgba(0,0,0,.25),0 20px 45px rgba(0,0,0,.5)}\n\n/* Archive paper: fixed rag/grain/press behavior; no universal texture chooser. */\n.pack-front.pack-paper .face{background:radial-gradient(circle at 8% 12%,rgba(93,61,31,.09),transparent 15%),radial-gradient(circle at 88% 82%,rgba(93,61,31,.075),transparent 17%),repeating-linear-gradient(0deg,rgba(99,67,38,.032) 0 1px,transparent 1px 4px),repeating-linear-gradient(90deg,rgba(83,55,31,.014) 0 1px,transparent 1px 17px),linear-gradient(180deg,color-mix(in srgb,var(--p) 48%,#f3e6c8),color-mix(in srgb,var(--p) 73%,#cfb17e))}\n.pack-front.pack-paper .v27-deed-edge{box-shadow:inset 0 0 0 4px rgba(115,79,43,.075),inset 0 0 0 5px rgba(255,255,255,.16),0 1px 0 rgba(255,255,255,.22)}\n\n/* Resin: optical mass / refraction only. */\n.pack-front.pack-resin .face{box-shadow:inset 4px 0 10px rgba(255,255,255,.09),inset -8px 0 14px rgba(0,0,0,.09),inset 0 3px 0 rgba(255,255,255,.12),inset 0 -4px 0 rgba(0,0,0,.12),inset 0 0 0 3px rgba(255,255,255,.035),0 28px 50px rgba(0,0,0,.42)}\n.pack-front.pack-resin .v27-resin-mass{box-shadow:inset 13px 0 20px rgba(255,255,255,.055),inset -15px 0 24px rgba(0,0,0,.07),inset 0 2px 0 rgba(255,255,255,.07),inset 0 -3px 0 rgba(0,0,0,.05)}\n\n/* ---------- Reverse content contract ---------- */\n.pack-back .face{overflow:hidden}\n.pack-back .back-panel{position:absolute;inset:8.5%;z-index:8;padding:15px 15px 13px;display:flex;flex-direction:column;border-radius:15px;overflow:hidden}\n.pack-back .back-topline{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:31px}\n.pack-back .back-brand{display:flex;align-items:center;gap:8px;min-width:0}\n.pack-back .back-logo{width:28px;height:28px;display:grid;place-items:center;flex:0 0 auto;border-radius:8px;overflow:hidden;font-family:Georgia,serif;font-weight:700;font-size:13px}\n.pack-back .back-logo .uploaded-logo-mark{width:80%;height:80%;object-fit:contain}\n.pack-back .back-brand-copy{min-width:0}\n.pack-back .back-brand-copy b{display:block;font-size:7.2px;line-height:1;letter-spacing:.17em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pack-back .back-brand-copy small{display:block;margin-top:4px;font-size:5.2px;line-height:1.1;letter-spacing:.15em;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pack-back .back-serial{font-size:6.4px;letter-spacing:.08em;white-space:nowrap}\n.pack-back .back-status{margin-top:13px;padding:10px 10px 9px;border-radius:10px;border:1px solid currentColor;display:flex;align-items:flex-start;gap:8px}\n.pack-back .back-status-dot{width:7px;height:7px;margin-top:1px;border-radius:50%;flex:0 0 auto;box-shadow:0 0 0 4px rgba(255,255,255,.035)}\n.pack-back .back-status b{display:block;font-size:7px;letter-spacing:.15em;text-transform:uppercase}\n.pack-back .back-status small{display:block;margin-top:4px;font-size:5.4px;line-height:1.25;letter-spacing:.04em;opacity:.7}\n.pack-back .back-name-row{margin-top:14px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:12px}\n.pack-back .back-name-kicker{display:block;font-size:5.4px;letter-spacing:.16em;text-transform:uppercase;opacity:.64;margin-bottom:4px}\n.pack-back .back-name{display:block;font-family:Georgia,serif;font-size:20px;line-height:1.02;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pack-back .back-edition{text-align:right;min-width:0}\n.pack-back .back-edition span{display:block;font-size:5px;letter-spacing:.14em;text-transform:uppercase;opacity:.62}\n.pack-back .back-edition strong{display:block;margin-top:4px;max-width:92px;font-size:6.2px;letter-spacing:.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pack-back .back-benefits{margin-top:17px;display:grid;grid-template-columns:repeat(3,1fr);gap:7px}\n.pack-back .back-benefit{min-height:79px;padding:10px 8px 8px;border:1px solid currentColor;border-radius:10px;display:flex;flex-direction:column}\n.pack-back .back-benefit span{font-size:4.9px;line-height:1.15;letter-spacing:.13em;text-transform:uppercase;opacity:.62}\n.pack-back .back-benefit strong{margin-top:10px;font-family:Georgia,serif;font-size:19px;line-height:1;font-weight:600}\n.pack-back .back-benefit small{margin-top:auto;padding-top:6px;font-size:5px;letter-spacing:.09em;text-transform:uppercase;opacity:.68}\n.pack-back .back-support{margin-top:10px;padding:9px 0;border-top:1px solid currentColor;border-bottom:1px solid currentColor;display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.pack-back .back-support>div:last-child{text-align:right}\n.pack-back .back-support span{display:block;font-size:4.9px;letter-spacing:.14em;text-transform:uppercase;opacity:.58;margin-bottom:4px}\n.pack-back .back-support strong{display:block;font-size:6.4px;letter-spacing:.08em;text-transform:uppercase}\n.pack-back .back-registry{margin-top:12px;display:grid;grid-template-columns:auto minmax(0,1fr) auto minmax(0,1fr);gap:5px 7px;align-items:center}\n.pack-back .back-registry span{font-size:4.6px;letter-spacing:.13em;text-transform:uppercase;opacity:.55}\n.pack-back .back-registry strong{font-size:5.8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.pack-back .back-note{margin-top:auto;padding-top:12px;padding-right:44px;font-size:5px;line-height:1.35;letter-spacing:.09em;text-transform:uppercase;opacity:.58}\n.pack-back .back-auth-seal{position:absolute;right:14px;bottom:13px;width:31px;height:31px;border-radius:50%;border:1px solid currentColor;opacity:.46}\n.pack-back .back-auth-seal::before{content:'';position:absolute;inset:5px;border-radius:50%;border:1px double currentColor}\n.pack-back .back-auth-seal::after{content:'\u2713';position:absolute;inset:0;display:grid;place-items:center;font-size:11px;font-weight:900}\n\n/* Reverse material identity by family. One benefits contract, eight physical constructions. */\n.pack-back.pack-slab .face{background:linear-gradient(90deg,rgba(255,255,255,.075),rgba(100,111,122,.045) 15%,rgba(255,255,255,.02) 50%,rgba(100,111,122,.045) 85%,rgba(255,255,255,.075));border:2px solid rgba(228,233,240,.25);box-shadow:inset 0 3px 0 rgba(255,255,255,.13),inset 2px 0 0 rgba(255,255,255,.05),inset -2px 0 0 rgba(0,0,0,.25),inset 0 -3px 0 rgba(0,0,0,.42),inset 0 0 0 4px rgba(255,255,255,.03)}\n.pack-back.pack-slab .back-panel{inset:7.2%;background:linear-gradient(180deg,color-mix(in srgb,var(--s) 94%,white),color-mix(in srgb,var(--s) 88%,#d9d5cc));border:6px solid var(--p);border-radius:4px;color:#171a1e;box-shadow:0 0 0 1px rgba(0,0,0,.82),0 12px 22px rgba(0,0,0,.24)}\n.pack-back.pack-slab .back-logo{background:var(--p);color:var(--s)}.pack-back.pack-slab .back-status,.pack-back.pack-slab .back-benefit{border-color:rgba(22,26,31,.18)}.pack-back.pack-slab .back-status-dot{background:var(--p)}.pack-back.pack-slab .back-support{border-color:rgba(22,26,31,.16)}\n\n.pack-back.pack-glass .face{background:linear-gradient(135deg,rgba(228,241,251,.10),rgba(90,126,152,.03) 35%,rgba(255,255,255,.035) 68%),linear-gradient(180deg,#11151b,#090c11);border:1px solid rgba(221,236,247,.25);box-shadow:inset 0 3px 0 rgba(235,248,255,.13),inset 2px 0 0 rgba(235,248,255,.06),inset -3px 0 0 rgba(0,0,0,.34),inset 0 -3px 0 rgba(0,0,0,.52),inset 0 0 0 7px color-mix(in srgb,var(--p) 34%,#1f242a),inset 0 0 0 10px rgba(255,255,255,.07),inset 0 0 0 22px #090c10}\n.pack-back.pack-glass .back-panel{inset:11%;background:linear-gradient(180deg,color-mix(in srgb,var(--a) 82%,#10161c),#0d1218);border:1px solid rgba(216,200,164,.22