-function rgbHex(r,g,b){
-  const h=n=>Math.max(0,Math.min(255,Math.round(n))).toString(16).padStart(2,'0');
-  return '#'+h(r)+h(g)+h(b);
-}
-function mixHex(a,b,t){
-  const A=hexRgb(a),B=hexRgb(b);
-  return rgbHex(A.r+(B.r-A.r)*t,A.g+(B.g-A.g)*t,A.b+(B.b-A.b)*t);
-}
