+function shortcutBar(current){return `<div class="nm-k-top"><div class="nm-k-crumb"><button onclick="go('home')">NexMarkets</button><i></i><span>${D(current)}</span></div><div class="nm-k-shortcuts"><button onclick="go('discover')">Discover</button><button onclick="go('market')">Trade</button><button onclick="go('create')" class="is-primary">Launch a Pass</button></div></div>`}
+function articleById(id){return docsArticles.find(a=>a.id===id)||docsArticles[0]}
+function categoryById(id){return docsCategories.find(c=>c.id===id)||docsCategories[0]}
+function articleSearchText(a){return [a.title,a.summary,categoryById(a.cat).title,...a.sections.flatMap(s=>[s[0],strip(s[1])])].join(' ').toLowerCase()}
+function docsMatches(){const q=docsQuery.trim().toLowerCase();if(!q)return docsArticles;const words=q.split(/\s+/).filter(Boolean);return docsArticles.filter(a=>words.every(w=>articleSearchText(a).includes(w)))}
+function docsSide(activeCat){return `<aside class="nm-k-sidebar">${docsCategories.map(c=>`<div class="nm-k-side-group"><span>${D(c.title)}</span>${docsArticles.filter(a=>a.cat===c.id).map(a=>`<button class="${a.id===docsArticle?'on':''}" onclick="nmOpenDoc('${a.id}')">${D(a.title)}</button>`).join('')}</div>`).join('')}</aside>`}
+function startCards(){const ids=['what-is-nexmarkets','read-pass-detail','read-exact-pass','create-stages'];return ids.map((id,i)=>{const a=articleById(id);return `<button class="nm-k-start-card" onclick="nmOpenDoc('${a.id}')"><span>${String(i+1).padStart(2,'0')}</span><div><b>${D(a.title)}</b><small>${D(a.summary)}</small></div></button>`}).join('')}
+function docsLibrary(){
+ const matches=docsMatches();
+ if(docsQuery.trim()){
+   return `<div class="nm-k-library"><div class="nm-k-results-head"><b>Search results</b><span>${matches.length} ${matches.length===1?'guide':'guides'}</span></div>${matches.length?`<div class="nm-k-guide-list">${matches.map(a=>`<button class="nm-k-guide" onclick="nmOpenDoc('${a.id}')"><div><b>${D(a.title)}</b><p>${D(a.summary)}</p></div><em>→</em></button>`).join('')}</div>`:`<div class="nm-k-no-results"><b>No guide matched that search.</b><p>Try a plain word such as Advantage, listing, USDG, Preview, royalty, serial or redemption.</p></div>`}</div>`
+ }
+ return `<div class="nm-k-library">${docsCategories.map(c=>{const as=docsArticles.filter(a=>a.cat===c.id);return `<section class="nm-k-category" id="docs-cat-${c.id}"><div class="nm-k-category-head"><div><h2>${D(c.title)}</h2><p>${D(c.desc)}</p></div><small>${as.length} ${as.length===1?'guide':'guides'}</small></div><div class="nm-k-guide-list">${as.map(a=>`<button class="nm-k-guide" onclick="nmOpenDoc('${a.id}')"><div><b>${D(a.title)}</b><p>${D(a.summary)}</p></div><em>→</em></button>`).join('')}</div></section>`}).join('')}</div>`
+}
+function docsHome(){return `<div class="nm-k-shell">${shortcutBar('Docs')}<header class="nm-k-hero"><div><span class="nm-k-kicker">NexMarkets Docs</span><h1>Understand it before you use it.</h1><p>Plain explanations for buying a Pass, using an Advantage, reading the Market, launching an Edition, and dealing with the wallet or network when something does not go as expected.</p></div><label class="nm-k-search">${searchIcon}<input id="nmDocsSearch" type="search" value="${D(docsQuery)}" placeholder="Search Passes, Advantages, listings, fees, USDG..." autocomplete="off"><kbd>/</kbd></label></header>${docsQuery.trim()?'':`<section class="nm-k-start" id="nmDocsStart"><div class="nm-k-section-title"><h2>Start with what you are trying to do</h2><span>Four useful entry points</span></div><div class="nm-k-start-grid">${startCards()}</div></section>`}<div class="nm-k-doc-layout">${docsSide('')}<main id="nmDocsLibrary">${docsLibrary()}</main></div></div>`}
+function docActions(a){if(!a.actions?.length)return '';return `<div class="nm-k-actions">${a.actions.map(x=>`<button class="${x[2]==='primary'?'primary':''}" onclick="go('${x[1]}')">${D(x[0])}</button>`).join('')}</div>`}
