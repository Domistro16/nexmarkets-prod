-function hexRgb(hex){
-  const h=String(hex||'#5f6f50').replace('#','').trim();
-  const f=h.length===3?h.split('').map(c=>c+c).join(''):h.padEnd(6,'0').slice(0,6);
-  return {r:parseInt(f.slice(0,2),16)||0,g:parseInt(f.slice(2,4),16)||0,b:parseInt(f.slice(4,6),16)||0};
