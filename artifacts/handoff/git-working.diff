-&lt;style&gt;
-/* LOCKED PHYSICAL EDGE: never theme this layer. Only the inner front/back surfaces change. */
-#card-root {
-  background:linear-gradient(148deg,#302d28 0%,#22201b 38%,#1b1916 65%,#21201c 100%) !important;
-  box-shadow:
-    inset 0 2px 0 rgba(255,255,255,0.09),
-    inset 1px 0 0 rgba(255,255,255,0.04),
-    inset 0 -2px 0 rgba(0,0,0,0.40),
-    0 4px 12px rgba(0,0,0,0.28),
-    0 18px 40px rgba(0,0,0,0.52),
-    0 50px 100px rgba(0,0,0,0.44) !important;
-}
-&lt;/style&gt;
-
-&lt;style&gt;
-/* ═══════════════════════════════════════════════════════════
-   4 PHYSICAL EDGE VARIANTS
-   [data-edge] selectors override the locked #card-root above
-   (attribute + ID = higher specificity, wins even vs !important)
-═══════════════════════════════════════════════════════════ */
-
-/* ── How the face recesses into the frame ─────────────────
-   All variants give the card-body a shadow that spills into
-   the frame area, making the face look SET into the bezel,
-   not painted flat on top of it.                          */
-#card-root[data-edge] .card-body {
-  transition: box-shadow 0.38s ease;
-}
-
-/* ────────────────────────────────────────────────────────────
-   EDGE 1 · OBSIDIAN  —  Machined cold-black metal
-   Like a watch case: top-lit specular, deep angled valleys,
-   bottom in shadow. Think TAG Heuer, not plastic.
-──────────────────────────────────────────────────────────── */
-#card-root[data-edge=&quot;obsidian&quot;] {
-  background:
-    /* Directional specular sweep: top-left bright corner */
-    linear-gradient(138deg,
-      rgba(255,255,255,0.11) 0%,
-      rgba(255,255,255,0.05) 18%,
-      transparent 38%
-    ),
-    /* Angled material gradient */
-    linear-gradient(148deg,
-      #3a3733 0%, #2c2a25 18%,
-      #1f1d19 38%, #1b1916 55%,
-      #242220 76%, #302e29 100%
-    ) !important;
-  box-shadow:
-    /* Top bevel — strong specular */
-    inset 0 3px 0   rgba(255,255,255,0.15),
-    inset 0 1.5px 0 rgba(255,255,255,0.08),
-    /* Left bevel */
-    inset 2.5px 0 0 rgba(255,255,255,0.06),
-    /* Right depth */
-    inset -2.5px 0 0 rgba(0,0,0,0.45),
-    /* Bottom — deepest shadow, no light reaches here */
-    inset 0 -3px 0  rgba(0,0,0,0.65),
-    /* Inner-edge ring (where face meets frame) */
-    inset 0 0 0 13px rgba(0,0,0,0.10),
-    /* Elevation cast shadows */
-    0 2px 6px   rgba(0,0,0,0.45),
-    0 10px 30px rgba(0,0,0,0.58),
-    0 32px 72px rgba(0,0,0,0.52),
-    0 72px 130px rgba(0,0,0,0.40) !important;
-}
-#card-root[data-edge=&quot;obsidian&quot;] .card-body {
-  box-shadow:
-    /* Face recesses INTO the bezel */
-    0 0 32px rgba(0,0,0,0.90),
-    0 0 6px  rgba(0,0,0,0.98),
-    /* Faint inner top-edge catch-light on the face bevel */
-    inset 0 1px 0 rgba(255,255,255,0.05) !important;
-}
-
-/* ────────────────────────────────────────────────────────────
-   EDGE 2 · GILT  —  Burnished antique gold foil
-   Hammered gold, warm specular, oxidized valleys.
-   Think vintage Pokémon gold star, 18-karat trophy edge.
-──────────────────────────────────────────────────────────── */
-#card-root[data-edge=&quot;gilt&quot;] {
-  background:
-    /* Hot-spot: bright flash at TL corner */
-    linear-gradient(132deg,
-      rgba(255,252,190,0.55) 0%,
-      rgba(255,240,140,0.22) 22%,
-      transparent 44%
-    ),
-    /* Dark valley shadows: BR corner */
-    linear-gradient(312deg,
-      rgba(40,16,0,0.52) 0%,
-      transparent 40%
-    ),
-    /* Hammered gold with multiple specular bands */
-    linear-gradient(162deg,
-      #5c3d0e  0%,
-      #9e7018  8%,  #d4a838 16%,
-      #f0d05a  24%, #c49224 32%,
-      #e2b824  40%, #f8dc60  47%,
-      #d49c18  54%, #a87620  62%,
-      #dab43a  72%, #f2d054  82%,
-      #8c6410  92%, #5c3d0e 100%
-    ) !important;
-  box-shadow:
-    /* Brilliant gold specular at very top */
-    inset 0 4px 0   rgba(255,252,165,0.78),
-    inset 0 1.5px 0 rgba(255,255,215,0.42),
-    /* Warm left-side catch */
-    inset 3px 0 0   rgba(255,228,100,0.22),
-    /* Oxidised dark right */
-    inset -3px 0 0  rgba(55,22,0,0.60),
-    /* Deep shadow underneath */
-    inset 0 -4px 0  rgba(42,16,0,0.82),
-    /* Warm amber glow under the card */
-    0 4px 10px  rgba(135,88,10,0.70),
-    0 14px 30px rgba(118,70,8,0.26),
-    0 40px 80px rgba(60,36,4,0.26),
-    0 80px 140px rgba(0,0,0,0.44) !important;
-}
-#card-root[data-edge=&quot;gilt&quot;] .card-body {
-  box-shadow:
-    0 0 36px rgba(18,6,0,0.94),
-    0 0 7px  rgba(0,0,0,0.99),
-    /* Warm gold rim where face meets frame */
-    inset 0 0 0 1px rgba(255,205,85,0.14),
-    inset 0 1px 0  rgba(255,240,140,0.07) !important;
-}
-
-/* ────────────────────────────────────────────────────────────
-   EDGE 3 · PRISM  —  Holographic rainbow prismatic
-   Like a Pokémon Rainbow Rare or Prizm Panini auto:
-   iridescent color that SHIFTS across the border.
-   Subtle animation keeps it alive without being gaudy.
-──────────────────────────────────────────────────────────── */
-@keyframes prism-drift {
-  0%   { background-position: 0%   50%, 100% 50%, 0% 0%; }
-  25%  { background-position: 65%  18%, 35%  82%, 0% 0%; }
-  50%  { background-position: 100% 50%, 0%   50%, 0% 0%; }
-  75%  { background-position: 35%  82%, 65%  18%, 0% 0%; }
-  100% { background-position: 0%   50%, 100% 50%, 0% 0%; }
-}
-#card-root[data-edge=&quot;prism&quot;] {
-  background:
-    /* Primary rainbow diagonal */
-    linear-gradient(148deg,
-      rgba(255,85,85,0.62)  0%,
-      rgba(255,195,0,0.58)  17%,
-      rgba(85,255,120,0.55) 34%,
-      rgba(45,215,255,0.62) 51%,
-      rgba(160,48,255,0.58) 68%,
-      rgba(255,48,198,0.55) 84%,
-      rgba(255,85,85,0.60) 100%
-    ),
-    /* Cross-sweep for depth of color rotation */
-    linear-gradient(266deg,
-      rgba(255,178,0,0.42)  0%,
-      rgba(56,192,255,0.42) 50%,
-      rgba(255,76,202,0.42) 100%
-    ),
-    /* Dark prismatic base — the &quot;foil backing&quot; */
-    linear-gradient(148deg,
-      #171726 0%, #0e0e1c 48%, #141422 100%
-    ) !important;
-  background-size: 220% 220%, 220% 220%, 100% 100% !important;
-  animation: prism-drift 9s ease-in-out infinite !important;
-  box-shadow:
-    /* White-light specular — any rainbow card has this at the top */
-    inset 0 3.5px 0 rgba(255,255,255,0.28),
-    inset 0 1.5px 0 rgba(255,255,255,0.15),
-    inset 2.5px 0 0 rgba(255,255,255,0.10),
-    inset -2.5px 0 0 rgba(0,0,0,0.55),
-    inset 0 -3.5px 0 rgba(0,0,0,0.72),
-    /* Colorful depth shadow — purple-blue tint */
-    0 4px 12px  rgba(118,56,235,0.12),
-    0 14px 36px rgba(60,16,188,0.14),
-    0 46px 90px rgba(0,0,0,0.54),
-    0 80px 140px rgba(0,0,0,0.38) !important;
-}
-#card-root[data-edge=&quot;prism&quot;] .card-body {
-  box-shadow:
-    0 0 34px rgba(0,0,18,0.94),
-    0 0 7px  rgba(0,0,0,0.99),
-    inset 0 0 0 1px rgba(200,176,255,0.10) !important;
-}
-/* Freeze animation during PNG capture */
-.capturing #card-root[data-edge=&quot;prism&quot;] {
-  animation: none !important;
-  background-position: 0% 50%, 100% 50%, 0% 0% !important;
-}
-
-/* ────────────────────────────────────────────────────────────
-   EDGE 4 · CARBON  —  Woven carbon-fibre composite
-   Technical cold-dark weave, like a McLaren interior panel
-   or a limited-run motorsport collectible card.
-──────────────────────────────────────────────────────────── */
-#card-root[data-edge=&quot;carbon&quot;] {
-  background:
-    /* Specular sweep from top-left */
-    linear-gradient(138deg,
-      rgba(255,255,255,0.13) 0%,
-      rgba(255,255,255,0.05) 20%,
-      transparent 40%
-    ),
-    /* 0°/90° fine tow lines — the horizontal warp threads */
-    repeating-linear-gradient(
-      0deg,
-      rgba(255,255,255,0.028) 0px, rgba(255,255,255,0.028) 1px,
-      transparent 1px, transparent 7px
-    ),
-    /* 45° diagonal weave — primary visible grain */
-    repeating-linear-gradient(
-      45deg,
-      rgba(0,0,0,0.62) 0px, rgba(0,0,0,0.62) 3.5px,
-      rgba(255,255,255,0.065) 3.5px, rgba(255,255,255,0.065) 7px
-    ),
-    /* -45° diagonal weave — creates the interlocking 2×2 twill */
-    repeating-linear-gradient(
-      -45deg,
-      rgba(0,0,0,0.50) 0px, rgba(0,0,0,0.50) 3.5px,
-      rgba(255,255,255,0.032) 3.5px, rgba(255,255,255,0.032) 7px
-    ),
-    /* Cold-blue-black base — carbon looks bluer than pure black */
-    linear-gradient(148deg,
-      #22232c 0%, #181820 38%,
-      #0f1014 58%, #1c1d26 100%
-    ) !important;
-  box-shadow:
-    /* Cold-metal top bevel */
-    inset 0 3px 0   rgba(255,255,255,0.20),
-    inset 0 1px 0   rgba(255,255,255,0.10),
-    inset 2.5px 0 0 rgba(255,255,255,0.08),
-    inset -2.5px 0 0 rgba(0,0,0,0.55),
-    inset 0 -3px 0  rgba(0,0,0,0.70),
-    /* Cold neutral drop shadows */
-    0 3px 12px  rgba(0,0,0,0.60),
-    0 14px 40px rgba(0,0,0,0.70),
-    0 48px 98px rgba(0,0,0,0.62),
-    0 88px 148px rgba(0,0,0,0.52) !important;
-}
-#card-root[data-edge=&quot;carbon&quot;] .card-body {
-  box-shadow:
-    0 0 30px rgba(0,0,0,0.94),
-    0 0 6px  rgba(0,0,0,0.99),
-    inset 0 0 0 1px rgba(255,255,255,0.065),
-    inset 0 1px 0  rgba(255,255,255,0.04) !important;
-}
-
-/* ────────────────────────────────────────────────────────────
-   FRAME COLOR PICKER UI
-──────────────────────────────────────────────────────────── */
-.frame-color-wrap {
-  display: inline-flex;
-  align-items: center;
-  gap: 8px;
-  min-height: 36px;
-  padding: 7px 12px;
-  border-radius: 999px;
