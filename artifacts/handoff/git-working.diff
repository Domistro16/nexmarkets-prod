tent:center;gap:5px;color:#f1f4f7}\n.pack-metal .v13-metal-id strong{font-size:8.3px;letter-spacing:.08em}\n\n/* 04 \u2014 ceramic: crafted fired object */\n.pack-ceramic{border-radius:32px}\n.pack-ceramic .depth{border-radius:32px;background:linear-gradient(145deg,color-mix(in srgb,var(--p) 58%,#17191b),#101214)}\n.pack-ceramic .face{border-radius:32px;background:radial-gradient(circle at 27% 13%,rgba(255,255,255,.27),transparent 13%),radial-gradient(circle at 77% 80%,rgba(0,0,0,.08),transparent 18%),linear-gradient(145deg,color-mix(in srgb,var(--p) 80%,white),var(--p) 50%,color-mix(in srgb,var(--p) 68%,black));border:1px solid rgba(255,255,255,.38);box-shadow:inset 0 0 0 7px rgba(255,255,255,.1),inset 0 -24px 32px rgba(0,0,0,.17),0 26px 54px rgba(0,0,0,.42)}\n.pack-ceramic .face::after{opacity:.055;background:radial-gradient(circle at 18% 24%,rgba(255,255,255,.28) 0 1px,transparent 1.4px),radial-gradient(circle at 76% 62%,rgba(0,0,0,.1) 0 1px,transparent 1.4px);background-size:29px 31px,37px 33px}\n.pack-ceramic .v13-crazing{position:absolute;inset:6%;border-radius:26px;opacity:.12;background:repeating-linear-gradient(29deg,transparent 0 20px,rgba(255,255,255,.12) 20px 21px,transparent 21px 40px),repeating-linear-gradient(-35deg,transparent 0 24px,rgba(0,0,0,.07) 24px 25px,transparent 25px 49px)}\n.pack-ceramic .v13-ceramic-head{position:absolute;left:13%;right:13%;top:10%;height:11%;z-index:7;border-radius:999px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.17);box-shadow:inset 0 1px 0 rgba(255,255,255,.12);display:grid;place-items:center;text-align:center;color:var(--s);padding:0 22px}\n.pack-ceramic .v13-ceramic-head .v13-title{font-size:17px}\n.pack-ceramic .v13-ceramic-head .v13-eyebrow{margin-top:3px;opacity:.8}\n.pack-ceramic .artwell{left:15%;right:15%;top:26.3%;border-radius:18px;border:8px solid color-mix(in srgb,var(--s) 88%,white);box-shadow:0 0 0 2px rgba(0,0,0,.24),0 12px 24px rgba(0,0,0,.26)}\n.pack-ceramic .v13-maker-copy{posi