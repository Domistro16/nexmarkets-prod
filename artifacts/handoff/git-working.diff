-.frame-color-wrap:hover { background: rgba(255,255,255,0.82); }
-.frame-color-wrap input[type=&quot;color&quot;] {
-  width: 18px; height: 18px;
-  border: none; background: transparent; padding: 0; cursor: pointer;
-}
-.frame-color-wrap input[type=&quot;color&quot;]::-webkit-color-swatch-wrapper { padding:0; }
-.frame-color-wrap input[type=&quot;color&quot;]::-webkit-color-swatch { border:none; border-radius:50%; }
-#frame-color-swatch {
-  width: 14px; height: 14px; border-radius: 50%;
-  border: 1px solid rgba(0,0,0,0.14); flex-shrink: 0;
