+function faqGroupsHtml(){const q=faqQuery.trim().toLowerCase();return faqGroups.map((g,gi)=>{const items=g.items.filter(x=>!q||strip(x[0]+' '+x[1]).toLowerCase().includes(q));if(!items.length)return '';return `<section class="nm-faq-group"><header><h2>${D(g.title)}</h2><p>${D(g.desc)}</p></header><div class="nm-faq-list">${items.map((x,i)=>faqItemHtml(x[0],x[1],`${gi}-${i}`)).join('')}</div></section>`}).join('')||`<div class="nm-k-no-results"><b>No answer matched that search.</b><p>Try Pass, Advantage, listing, fee, Builder, wallet, Preview or USDG.</p></div>`}
+window.renderFaqPage=function(){const m=document.getElementById('nmFaqMount');if(!m)return;m.innerHTML=`<div class="nm-faq-shell">${shortcutBar('FAQ')}<header class="nm-faq-hero"><span class="nm-k-kicker">FAQ</span><h1>Questions people actually ask.</h1><p>Shorter than the Docs, but still complete enough to help you decide what to do next. If an answer needs more context, open the related Docs from the footer or product menu.</p><label class="nm-k-search nm-faq-search">${searchIcon}<input id="nmFaqSearch" type="search" value="${D(faqQuery)}" placeholder="Search questions..." autocomplete="off"></label></header><div class="nm-faq-groups" id="nmFaqGroups">${faqGroupsHtml()}</div></div>`;const i=document.getElementById('nmFaqSearch');if(i)i.addEventListener('input',e=>{faqQuery=e.target.value;document.getElementById('nmFaqGroups').innerHTML=faqGroupsHtml()})};
+window.nmToggleFaq=function(btn){const item=btn.closest('.nm-faq-item');if(item)item.classList.toggle('open')};
+
+function termsHtml(){return `<div class="nm-terms-shell">${shortcutBar('Terms')}<header class="nm-terms-hero"><span class="nm-k-kicker">Terms of Use</span><h1>Rules written for people to read.</h1><p>These Terms explain the main rules for using NexMarkets, buying and selling Passes, using Advantages, and publishing a Debut. They do not replace the specific terms of an individual Edition.</p><div class="nm-terms-meta"><span>Current working version</span><span>Updated 24 August 2026</span></div></header><div class="nm-terms-layout"><aside class="nm-terms-toc"><b>On this page</b>${termsSections.map(s=>`<a href="#terms-${s[0]}">${D(s[1].replace(/^\d+\.\s*/,''))}</a>`).join('')}</aside><main class="nm-terms-body">${termsSections.map(s=>`<section id="terms-${s[0]}"><h2>${D(s[1])}</h2>${s[2]}</section>`).join('')}<div class="nm-k-actions"><button class="primary" onclick="go('docs')">Read the Docs</button><button onclick="go('faq')">Open FAQ</button></div></main></div></div>`}
