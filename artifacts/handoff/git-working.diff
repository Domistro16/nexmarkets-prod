11px;color:#dce1e8}\n.pack-slab .v13-slab-footer .v13-code{text-align:center;color:#b9c1cb}\n\n/* 02 \u2014 museum glass: preservation object */\n.pack-glass{border-radius:22px}\n.pack-glass .depth{border-radius:22px;background:linear-gradient(145deg,#0e1217,#252b33)}\n.pack-glass .face{border-radius:22px;background:linear-gradient(135deg,rgba(229,242,250,.08),rgba(92,126,151,.025) 38%,rgba(255,255,255,.035) 68%,rgba(255,255,255,.055)),linear-gradient(180deg,#10151a,#090d11);border:1px solid rgba(220,234,244,.22);box-shadow:inset 0 0 0 7px color-mix(in srgb,var(--p) 18%,#20242b),inset 0 0 0 10px rgba(255,255,255,.08),inset 0 0 0 22px #090c10,0 20px 40px rgba(0,0,0,.46)}\n.pack-glass .face::before{opacity:.12;background:radial-gradient(circle at 10% 15%,rgba(255,255,255,.06),transparent 28%),radial-gradient(circle at 90% 16%,rgba(255,255,255,.055),transparent 28%),linear-gradient(180deg,rgba(255,255,255,.018),transparent 20% 80%,rgba(255,255,255,.015))}\n.pack-glass .face::after{opacity:.035}\n.pack-glass .v13-mat{position:absolute;left:11.7%;right:11.7%;top:8.5%;bottom:8.3%;border-radius:18px;background:radial-gradient(circle at 30% 18%,rgba(255,255,255,.022),transparent 18%),linear-gradient(180deg,color-mix(in srgb,var(--a) 90%,black),#10161b);border:1px solid rgba(255,255,255,.045);box-shadow:inset 0 0 26px rgba(0,0,0,.35)}\n.pack-glass .v13-accession{position:absolute;left:15.3%;right:15.3%;top:10.2%;height:5.1%;z-index:7;display:flex;align-items:center;justify-content:space-between;gap:10px}\n.pack-glass .v13-accession .v13-tab{padding:5px 8px;border-radius:6px;background:linear-gradient(#ded2b4,#baaa82);color:#20180f;font-size:7px;letter-spacing:.13em;text-transform:uppercase;box-shadow:0 2px 8px rgba(0,0,0,.22);white-space:nowrap}\n.pack-glass .v13-accession .v13-brand{color:#d7c697}\n.pack-glass .v13-museum-heading{position:absolute;left:16%;right:16%;top:16.3%;height:8.2%;z-index:7;display:grid;place-items:center;text-align:center;color:#eee4ce}\n.pack-glass .v13-museum-heading .v13-title{font-size:18px}\n.pack-glass .v13-museum-heading .v13-eyebrow{margin-top:4px;color:#bda97d}\n.pack-glass .v13-museum-rule{position:absolute;left:34%;right:34%;top:25.3%;height:1px;z-index:7;background:linear-gradient(90deg,transparent,rgba(216,200,164,.52),transparent)}\n.pack-glass .artwell{left:19%;right:19%;top:29%;border-radius:12px;border:1px solid rgba(255,255,255,.17);box-shadow:0 0 0 9px color-mix(in srgb,var(--s) 38%,#2a2e33),0 0 0 11px rgba(255,255,255,.10),0 14px 30px rgba(0,0,0,.35)}\n.pack-glass .v13-curator{position:absolute;left:15%;right:15%;bottom:8.3%;height:14.4%;z-index:7;border-radius:8px;overflow:hidden;background:linear-gradient(#dcd0b3,#91805e);color:#1a150f;border:1px solid #e8d8ad;box-shadow:inset 0 0 0 1px rgba(0,0,0,.2),0 8px 18px rgba(0,0,0,.16)}\n.pack-glass .v13-curator-main{height:69%;padding:10px 12px 8px}\n.pack-glass .v13-curator-main .v13-eyebrow{margin-bottom:4px;color:#56462f}\n.pack-glass .v13-curator-main .v13-copy{font-size:8.45px;line-height:1.34;color:#281f15}\n.pack-glass .v13-curator-foot{height:31%;display:grid;grid-template-columns:1fr 1.15fr 1fr;border-top:1px solid rgba(63,47,26,.2)}\n.pack-glass .v13-curator-foot span{display:grid;place-items:center;font-size:7.2px;letter-spacing:.09em;text-transform:uppercase;color:#332719}\n.pack-glass .v13-curator-foot span+span{border-left:1px solid rgba(63,47,26,.15)}\n\n/* 03 \u2014 machined metal: engineering object */\n.pack-metal{border-radius:24px}\n.pack-metal .depth{border-radius:24px;background:linear-gradient(90deg,#080a0d,#404650 15%,#798089 27%,#30353d 41%,#777f87 51%,#2b3038 63%,#70777e 78%,#282d34 89%,#08090b)}\n.pack-metal .face{border-radius:24px;background:repeating-linear-gradient(90deg,color-mix(in srgb,var(--p) 50%,#777e86) 0 1px,color-mix(in srgb,var(--p) 61%,#565d65) 1px 5px,color-mix(in srgb,var(--p) 44%,#d5d9dc) 5px 6px,color-mix(in srgb,var(--p) 64%,#535a63) 6px 10px),linear-gradient(180deg,rgba(255,255,255,.06),rgba(0,0,0,