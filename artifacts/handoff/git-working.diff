TE OBJECT REBUILD\n   bespoke information architecture per family\n   ============================== */\n.v13-brand{display:flex;align-items:center;gap:7px;font-size:7.6px;letter-spacing:.14em;text-transform:uppercase;font-weight:800;white-space:nowrap}\n.v13-brandmark{width:19px;height:19px;border-radius:6px;display:grid;place-items:center;font-family:Georgia,serif;font-size:10px;font-weight:700;background:linear-gradient(145deg,color-mix(in srgb,var(--p) 78%,white),color-mix(in srgb,var(--p) 72%,black));color:var(--s);box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 2px 6px rgba(0,0,0,.22)}\n.v13-eyebrow{font-size:7px;letter-spacing:.15em;text-transform:uppercase;font-weight:800}\n.v13-title{font-family:Georgia,serif;font-weight:650;line-height:1.02}\n.v13-copy{font-size:8.55px;line-height:1.32}\n.v13-code{font-size:7.2px;letter-spacing:.11em;text-transform:uppercase}\n.v13-separator{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.28),transparent)}\n\n/* 01 \u2014 graded slab: authentication object */\n.pack-slab{border-radius:27px}\n.pack-slab .depth{border-radius:27px;background:linear-gradient(90deg,#080a0d,#313740 12%,#666d76 25%,#272c33 42%,#858b91 50%,#282d34 61%,#60676f 76%,#2a3037 89%,#080a0d)}\n.pack-slab .face{border-radius:27px;background:linear-gradient(90deg,rgba(255,255,255,.11),rgba(116,126,137,.14) 18%,rgba(255,255,255,.045) 52%,rgba(52,58,66,.15) 82%,rgba(255,255,255,.07));border:1px solid rgba(230,235,241,.28);box-shadow:inset 0 0 0 3px rgba(255,255,255,.035),inset 0 0 17px rgba(255,255,255,.035)}\n.pack-slab .face::before{opacity:.15;background:radial-gradient(circle at 8% 16%,rgba(255,255,255,.08),transparent 24%),radial-gradient(circle at 92% 18%,rgba(255,255,255,.07),transparent 24%),linear-gradient(180deg,rgba(255,255,255,.03),transparent 18% 84%,rgba(255,255,255,.02))}\n.pack-slab .face::after{opacity:.045}\n.pack-slab .v13-slab-rail{position:absolute;inset:4.2% 5.2% 4.4%;border-radius:21px;border:1px solid rgba(25