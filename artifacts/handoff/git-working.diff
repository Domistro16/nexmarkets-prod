n.asset-upload small{display:block;margin-top:5px;font-size:8px;line-height:1.3;color:#747f8b}\n.uploaded-logo-mark{display:block;width:76%;height:76%;object-fit:contain;object-position:center}\n.uploaded-logo-inline{display:inline-flex;align-items:center;justify-content:center;height:1.15em;max-width:42px;margin-right:.32em;vertical-align:-.12em}\n.uploaded-logo-inline img{display:block;height:100%;width:auto;max-width:42px;object-fit:contain}\n@media(max-width:720px){.asset-upload-grid{grid-template-columns:1fr}}\n.export-png-btn{width:100%;margin-top:10px;padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.12);background:linear-gradient(180deg,#1a2028,#11161c);color:#f3f5f7;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 7px 16px rgba(0,0,0,.16)}\n.export-png-btn:hover{background:linear-gradient(180deg,#222a34,#151b22);border-color:rgba(255,255,255,.2)}\n.export-png-btn:disabled{opacity:.55;cursor:wait}\n.export-note{margin-top:7px;font-size:8px;line-height:1.35;color:#747f8b}\n\n\n\n/* =========================================================\n   V28 MATERIAL AUTHORITY + PHYSICAL REVERSE\n   Layout geometry of the eight approved fronts is unchanged.\n   This layer upgrades material response only and adds a true reverse.\n   ========================================================= */\n\n/* Whole-object front / reverse architecture. */\n.object-flipper{position:absolute;inset:0;transform-style:preserve-3d;transition:transform 760ms cubic-bezier(.18,.78,.18,1);will-change:transform}\n.object[data-side=\"back\"] .object-flipper{transform:rotateY(180deg)}\n.object-flipper>.pack{backface-visibility:hidden;-webkit-backface-visibility:hidden}\n.object-flipper>.pack-front{transform:rotateY(0deg) translateZ(.2px)}\n.object-flipper>.pack-back{transform:rotateY(180deg) translateZ(.2px)}\n\n.side-toggle-wrap{margin-top:10px;padding:9px;border:1px solid rgba(255,255,255,.08);border-radius:12px;background:#0f1218}\n.side-toggle-label{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#a2acb7;margin-bottom:7px}\n.side-toggle{display:grid;grid-template-columns:1fr 1fr;gap:6px}\n.side-btn{padding:8px 9px;border-radius:9px;border:1px solid rgba(255,255,255,.08);background:#151a21;color:#aeb7c1;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}\n.side-btn.active{background:color-mix(in srgb,var(--p) 42%,#171c23);border-color:color-mix(in srgb,var(--p) 60%,rgba(255,255,255,.2));color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}\n\n/* ---------- Selective donor techniques from v5.1: material physics only. ---------- */\n/* Slab: cold directional edge specular + recessed face contact. */\n.pack-front.pack-slab .depth{background:linear-gradient(138deg,rgba(255,255,255,.12),transparent 22%),linear-gradient(90deg,#0d1115 0%,#2b3239 10%,#3b434b 18%,#252b31 30%,#20262c 50%,#252b31 70%,#3b434b 82%,#2b3239 90%,#0d1115 100%)}\n.pack-front.pack-slab .face{box-shadow:inset 0 3px 0 rgba(255,255,255,.13),inset 2px 0 0 rgba(255,255,255,.055),inset -2px 0 0 rgba(0,0,0,.25),inset 0 -3px 0 rgba(0,0,0,.42),inset 0 0 0 4px rgba(255,255,255,.032),inset 0 0 16px rgba(255,255,255,.025),0 18px 34px rgba(0,0,0,.24)}\n.pack-front.pack-slab .artwell{box-shadow:0 0 0 2px rgba(0,0,0,.82),0 0 22px rgba(0,0,0,.75),0 10px 22px rgba(0,0,0,.38)}\n\n/* Museum glass: Fresnel edge, bright top/left, deep underside. */\n.pack-front.pack-glass .face{box-shadow:inset 0 3px 0 rgba(235,248,255,.14),inset 2px 0 0 rgba(235,248,255,.07),inset -3px 0 0 rgba(0,0,0,.34),inset 0 -3px 0 rgba(0,0,0,.52),inset 0 0 0 7px color-mix(in srgb,var(--p) 34%,#1f242a),inset 0 0 0 10px rgba(255,255,255,.08),inset 0 0 0 22px #090c10,0 20px 40px rgba(0,0,0,.46)}\n.pack-front.pack-glass .face::before{opacity:.18;background:radial-gradient(circle at var(--gx) var(--gy),rgba(236,248,255,.22),transparent 18%),linear-gradient(124deg,rgba(255,255,255,.11),tran