-  const { h, s, l } = rgbToHsl(...Object.values(hexToRgb(baseHex)));
-  const lightTheme = l &gt;= 66;
-  const sat = Math.max(s, 10);
-
-  let shell1, shell2, shell3, shell4, inner1, inner2, inner3, back1, back2, back3, primary, secondary, accent, subtle, muted, provenance;
-
-  if (lightTheme) {
-    shell1 = hslToHex(h, sat * 0.28, clamp(l - 8, 68, 88));
-    shell2 = hslToHex(h, sat * 0.24, clamp(l - 15, 58, 82));
-    shell3 = hslToHex(h, sat * 0.22, clamp(l - 20, 52, 76));
-    shell4 = hslToHex(h, sat * 0.24, clamp(l - 16, 56, 80));
-    inner1 = hslToHex(h, sat * 0.24, clamp(l - 2, 74, 92));
-    inner2 = hslToHex(h, sat * 0.20, clamp(l - 6, 70, 88));
-    inner3 = hslToHex(h, sat * 0.18, clamp(l - 10, 64, 84));
-    back1 = hslToHex(h, sat * 0.22, clamp(l - 10, 60, 82));
-    back2 = hslToHex(h, sat * 0.20, clamp(l - 16, 54, 76));
-    back3 = hslToHex(h, sat * 0.18, clamp(l - 20, 50, 72));
-    primary = hslToHex(h, sat * 0.16, 18);
-    secondary = hslToHex(h, Math.max(sat * 0.45, 22), 34);
-    accent = hslToHex(h, Math.max(sat * 0.40, 18), 42);
-    subtle = hslToHex(h, sat * 0.20, 34);
-    muted = hslToHex(h, sat * 0.16, 42);
-    provenance = hslToHex(h, sat * 0.20, 38);
-  } else {
-    shell1 = hslToHex(h, sat * 0.42, clamp(l - 4, 16, 34));
-    shell2 = hslToHex(h, sat * 0.34, clamp(l - 8, 12, 28));
-    shell3 = hslToHex(h, sat * 0.30, clamp(l - 12, 8, 24));
-    shell4 = hslToHex(h, sat * 0.34, clamp(l - 9, 10, 26));
-    inner1 = hslToHex(h, sat * 0.48, clamp(l + 2, 14, 38));
-    inner2 = hslToHex(h, sat * 0.40, clamp(l - 3, 10, 30));
-    inner3 = hslToHex(h, sat * 0.34, clamp(l - 7, 8, 24));
-    back1 = hslToHex(h, sat * 0.40, clamp(l - 1, 12, 28));
-    back2 = hslToHex(h, sat * 0.34, clamp(l - 6, 8, 24));
-    back3 = hslToHex(h, sat * 0.30, clamp(l - 10, 6, 20));
-    primary = &#x27;#f7f2ea&#x27;;
-    secondary = hslToHex(h, Math.max(sat * 0.42, 18), 76);
-    accent = hslToHex(h, Math.max(sat * 0.40, 18), 66);
-    subtle = hslToHex(h, Math.max(sat * 0.22, 12), 56);
-    muted = hslToHex(h, Math.max(sat * 0.18, 10), 64);
-    provenance = hslToHex(h, Math.max(sat * 0.24, 10), 52);
-  }
-  root.style.setProperty(&#x27;--theme-inner-1&#x27;, inner1);
-  root.style.setProperty(&#x27;--theme-inner-2&#x27;, inner2);
-  root.style.setProperty(&#x27;--theme-inner-3&#x27;, inner3);
-  root.style.setProperty(&#x27;--theme-back-1&#x27;, back1);
-  root.style.setProperty(&#x27;--theme-back-2&#x27;, back2);
-  root.style.setProperty(&#x27;--theme-back-3&#x27;, back3);
-  root.style.setProperty(&#x27;--theme-back-spot&#x27;, rgbaString(accent, 0.14));
-  root.style.setProperty(&#x27;--theme-primary&#x27;, primary);
-  root.style.setProperty(&#x27;--theme-secondary&#x27;, secondary);
-  root.style.setProperty(&#x27;--theme-accent&#x27;, accent);
-  root.style.setProperty(&#x27;--theme-subtle&#x27;, subtle);
-  root.style.setProperty(&#x27;--theme-muted&#x27;, muted);
-  root.style.setProperty(&#x27;--theme-provenance&#x27;, provenance);
-  root.style.setProperty(&#x27;--theme-accent-soft&#x27;, rgbaString(accent, 0.22));
-  root.style.setProperty(&#x27;--theme-accent-glow&#x27;, rgbaString(accent, 0.14));
-  root.style.setProperty(&#x27;--theme-accent-wash&#x27;, rgbaString(accent, 0.10));
