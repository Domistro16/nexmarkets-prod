+  document.getElementById('dashModalTitle').textContent=title;
+  document.getElementById('dashModalBody').innerHTML=body;
+  const confirm=document.getElementById('dashModalConfirm');
+  confirm.textContent=confirmLabel||'Confirm';
+  dashboardModalAction=action||null;
+  modal.classList.add('open');
