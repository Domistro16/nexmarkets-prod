+    <div class="launch-visual"></div>
+    <div class="launch-bottom"><h3>${esc(p.name)}</h3><p>${esc(p.desc)}</p>
+      <div class="launch-meta"><span>${money(p.price)} · ${p.supply} Passes</span><strong>${esc(tail)}</strong></div>
+    </div>
+  </article>`;
 }
