+const docsCategories=[
+ {id:'start',title:'Start here',desc:'The shortest path to understanding what NexMarkets is and how the pieces fit together.'},
+ {id:'discover',title:'Discover and Debuts',desc:'How to inspect a product before a Debut opens, and how to decide whether a Pass makes sense for you.'},
+ {id:'passes',title:'Passes and ownership',desc:'What you actually own, how serials work, and what changes after a purchase.'},
+ {id:'advantages',title:'Advantages',desc:'How holder benefits work, what remains with a Pass, and what happens when a Pass is listed or sold.'},
+ {id:'market',title:'Market and trading',desc:'How to compare exact Passes without turning normal market information into noise.'},
+ {id:'builders',title:'For Builders',desc:'How to turn a real product into a clear Edition, set the Advantage, and publish a Debut people can inspect.'},
+ {id:'wallet',title:'Wallet and payment',desc:'USDG, wallet confirmations, pending transactions, and the things that cannot be undone.'},
