-function extractThemeColor(src) {
-  return new Promise((resolve, reject) =&gt; {
-    const img = new Image();
-    img.onload = () =&gt; {
-      const canvas = document.createElement(&#x27;canvas&#x27;);
-      const size = 48;
-      canvas.width = size;
-      canvas.height = size;
-      const ctx = canvas.getContext(&#x27;2d&#x27;, { willReadFrequently:true });
-      ctx.drawImage(img, 0, 0, size, size);
-      const data = ctx.getImageData(0, 0, size, size).data;
-      let totalWeight = 0;
-      let sumR = 0, sumG = 0, sumB = 0;
-      let fallbackWeight = 0;
-      let fallbackR = 0, fallbackG = 0, fallbackB = 0;
-      for (let i = 0; i &lt; data.length; i += 4) {
-        const a = data[i + 3] / 255;
-        if (a &lt; 0.12) continue;
-        const r = data[i], g = data[i + 1], b = data[i + 2];
-        const { s, l } = rgbToHsl(r, g, b);
-        const vividWeight = a * (0.35 + s / 100 + (1 - Math.abs((l / 100) - 0.55)));
-        const neutralWeight = a * 0.8;
-        if (s &gt; 8 &amp;&amp; l &gt; 8 &amp;&amp; l &lt; 95) {
-          totalWeight += vividWeight;
-          sumR += r * vividWeight;
-          sumG += g * vividWeight;
-          sumB += b * vividWeight;
-        }
-        fallbackWeight += neutralWeight;
-        fallbackR += r * neutralWeight;
-        fallbackG += g * neutralWeight;
-        fallbackB += b * neutralWeight;
-      }
-      if (totalWeight &gt; 0.001) {
-        resolve(rgbToHex(sumR / totalWeight, sumG / totalWeight, sumB / totalWeight));
-      } else if (fallbackWeight &gt; 0.001) {
-        resolve(rgbToHex(fallbackR / fallbackWeight, fallbackG / fallbackWeight, fallbackB / fallbackWeight));
-      } else {
-        resolve(&#x27;#6b4b3d&#x27;);
-      }
-    };
-    img.onerror = reject;
-    img.src = src;
-  });
-}
 
