{
  "name": "nexmarkets-production",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/auth",
    "packages/chain",
    "packages/config",
    "packages/data",
    "packages/domain",
    "packages/observability",
    "packages/subgraph-client"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:api": "node --test test/api*.test.mjs",
    "test:web": "node --test test/web*.test.mjs",
    "build": "node scripts/build-web.mjs",
    "web:build": "node scripts/build-web.mjs",
    "web:config:testnet": "node scripts/render-web-config.mjs",
    "web:serve:testnet": "node --env-file=.env scripts/serve-web-testnet.mjs",
    "test:browser": "playwright test --config=test/playwright.config.mjs",
    "db:migrate": "node infra/schema/migrate.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:goldsky": "node scripts/verify-goldsky-config.mjs",
    "goldsky:render": "node scripts/render-goldsky-config.mjs",
    "subgraph:codegen": "npm --prefix subgraph run codegen",
    "subgraph:build": "npm --prefix subgraph run build",
    "subgraph:test": "npm --prefix subgraph test",
    "subgraph:sync-abis": "node scripts/sync-subgraph-abis.mjs",
    "goldsky:retention-report": "node scripts/report-goldsky-raw-retention.mjs",
    "verify:production": "node scripts/verify-production-config.mjs",
    "deploy:v1:bundles": "node scripts/build-v1-safe-bundles.mjs",
    "deploy:v1:plan:mainnet": "node scripts/plan-v1-deployment.mjs --mainnet --source-commit=8790b635ba55512e5d0e295fb1217a3993ecdafb --inputs=deployments/nexmarkets-v1.inputs.robinhood-mainnet.json",
    "deploy:v1:plan:testnet": "node scripts/plan-v1-deployment.mjs --source-commit=8790b635ba55512e5d0e295fb1217a3993ecdafb --inputs=deployments/nexmarkets-v1.inputs.robinhood-testnet.json",
    "deploy:v1:plan:base:testnet": "node scripts/plan-v1-deployment.mjs --network=base-sepolia --source-commit=8790b635ba55512e5d0e295fb1217a3993ecdafb --inputs=deployments/nexmarkets-v1.inputs.base-sepolia.json",
    "deploy:v1:plan:base:mainnet": "node scripts/plan-v1-deployment.mjs --network=base-mainnet --source-commit=8790b635ba55512e5d0e295fb1217a3993ecdafb --inputs=deployments/nexmarkets-v1.inputs.base-mainnet.json",
    "verify:checksums": "node scripts/verify-checksums.mjs",
    "checksums:regenerate": "node scripts/regenerate-checksums.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/verify-no-secrets.mjs",
    "safe:plan": "node scripts/deploy-safe.mjs",
    "safe:plan:testnet": "node scripts/deploy-safe.mjs --network=robinhood-testnet",
    "safe:plan:base:testnet": "node scripts/deploy-safe.mjs --network=base-sepolia",
    "safe:plan:base:mainnet": "node scripts/deploy-safe.mjs --network=base-mainnet",
    "mock-usdg:plan:testnet": "node scripts/deploy-testnet-mock-usdg.mjs",
    "mock-usdg:mint:testnet": "node --env-file=.env scripts/mint-testnet-mock-usdg.mjs",
    "certification:mint:testnet": "node --env-file=.env scripts/mint-testnet-certification-pass.mjs",
    "certification:lifecycle:testnet": "node --env-file=.env scripts/run-testnet-certification-lifecycle.mjs",
    "safe:deploy": "node scripts/deploy-safe.mjs --broadcast",
    "safe:deploy:testnet": "node scripts/deploy-safe.mjs --network=robinhood-testnet --broadcast",
    "safe:deploy:base:testnet": "node scripts/deploy-safe.mjs --network=base-sepolia --broadcast",
    "safe:verify": "node scripts/verify-safe-approval.mjs",
    "verify:authority": "node scripts/verify-product-authority.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:primitives:mainnet": "node scripts/verify-primitives.mjs --network robinhood-mainnet",
    "verify:primitives:testnet": "node scripts/verify-primitives.mjs --network robinhood-testnet",
    "verify:primitives:mainnet:strict": "node scripts/verify-primitives.mjs --network robinhood-mainnet --strict",
    "phase01:check": "node scripts/phase01-check.mjs",
    "preflight:seaport": "node scripts/preflight-canonical-seaport.mjs robinhood-mainnet"
  },
  "dependencies": {
    "esbuild": "0.25.0",
    "ethers": "6.17.0",
    "pg": "8.16.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
